Credits: {
	Tooltip: ""

	Vanilla: {
		Label: 月亮领主之后
		Tooltip: ""
	}

	AfterModsFinalBoss: {
		Label: 通关最终boss（加载模组）
		Tooltip: ""
	}

	Disabled: {
		Label: 没有鸣谢
		Tooltip: ""
	}
}

UIConfig: {
	DisplayName: UI配置

	enableNPCSellPrices: {
		Label: "[i:73] 启用NPC出售价格"
		Tooltip:
			'''
			如果启用，在物品上按住收藏键可以显示每个贪婪的NPC会卖给你多少钱。
			剧透：永远不够。
			'''
	}

	npcSellPriceYOffset: {
		Label: "[i:888] 垂直定位"
		Tooltip: 把价格显示从NPC那张愚蠢的脸上挪多远啊。负值向上，正值向下。 (默认值: 0)
	}

	npcSellPriceXOffset: {
		Label: "[i:888] 水平定位"
		Tooltip: 把价格显示移动到多远的右边，这样它就不会遮挡NPC那张像素化的失望表情了。 (默认值: 40)
	}

	showPriceMultiplier: {
		Label: "[i:855] 显示价格乘数"
		Tooltip: 如果启用，系统会显示每个NPC对你的好感值。红色表示他们恨你，绿色表示他们只是不喜欢你。
	}

	showCoinIcon: {
		Label: "[i:71] 显示硬币图标"
		Tooltip: 如果启用，会在数字旁边显示闪亮的硬币图标，因为显然我们无法在没有漂亮图片的情况下阅读数字。
	}

	npcSellPriceShowBackground: {
		Label: "[i:1344] 显示背景面板"
		Tooltip: 如果启用的话，会添加一个背景，这样你就可以清楚地阅读文本，而不用像老年人那样眯着眼睛看。
	}

	npcSellPriceBackgroundPadding: {
		Label: "[i:1344] 背景填充"
		Tooltip: 控制背景在文本周围的厚度。数字越大 = 填充越多 = 更容易阅读。 (默认值: 5)
	}

	backgroundColor: {
		Label: "[i:1344] 静态背景颜色"
		Tooltip: 当你觉得动态选项太无聊时，可以选择一种背景颜色。
	}

	dynamicBackgroundColor: {
		Label: "[i:1345] 动态背景颜色"
		Tooltip:
			'''
			如果启用，背景颜色会根据每个NPC对你有多讨厌而变化。
			[c/FF0000:Red] 代表 "我非常讨厌你", [c/22EE00:Green] 代表 "我忍受你的存在。"
			'''
	}

	npcSellPriceBackgroundColor: {
		Label: "[i:1344] 手动背景颜色"
		Tooltip: 当你想要精细地管理你的用户界面失望的具体程度时。
	}

	fixConfigSyncCrash: {
		Label: "[i:3625] 修复模组同步崩溃"
		Tooltip:
			'''
			启用后，修复tModLoader的一个Bug——加入拥有新增配置页的模组服务器时会报错，
			并导致游戏永久卡在“同步模组”界面。属实拉胯。
			'''
	}

	Headers: {
		DisplayNPCSellPrices: "[i:73] NPC售卖价格展示"
		multiplayer: "[i:181] Multiplayer"
	}
}

DamageSpread: {
	Off: {
		Label: 关闭
		Tooltip: ""
	}

	PlayersEnemies: {
		Label: 玩家和敌人（默认）
		Tooltip: ""
	}

	Enemies: {
		Label: 只有敌人
		Tooltip: ""
	}

	Tooltip: ""
}

QoLRecipeConfig: {
	DisplayName: 配方选项
	Tooltip: For the square chicks

	Headers: {
		recipes: "[i:2633] 配方"
		craftableUncraftables: "[i:36] Craftable Uncraftables"
		shimmer: "[i:5350] 可微光"
	}

	debuffImmunityRecipes: {
		Label: "[i:891] 减益免疫饰品"
		Tooltip:
			'''
			启用后，你可以直接制作 邪眼、牛黄、维生素、蒙眼布、三折地图、快速时钟、扩音器、袖珍镜、
			盔甲抛光剂和粘性绷带，而不用再去凹掉落率了。
			'''
	}

	lootAccessories: {
		Label: "[i:934] 饰品"
		Tooltip:
			'''
			启用后，为原本只能通过探索获取的饰品添加制作配方：猛爪手套、再生手环、
			鞋钉、冰冻海龟壳、魔法箭袋、金属探测器及其同类物品。
			同时允许机械手套和天界徽章使用任意徽章制作。
			'''
	}

	lootGear: {
		Label: "[i:724] 武器与时装"
		Tooltip: 启用后，为冰雪回旋镖、手里剑、飞刀以及法老套装添加制作配方。
	}

	lootTools: {
		Label: "[i:50] 工具与工作台"
		Tooltip:
			'''
			启用后，为魔镜、冰雪镜、虫网、绿化法杖、冰雪机、
			天空磨坊和沙漠矿车添加制作配方。
			'''
	}

	lootKeys: {
		Label: "[i:1533] 钥匙与召唤物"
		Tooltip:
			'''
			启用后，为神庙钥匙、暗影钥匙、丛林蜥蜴电池、向导巫毒娃娃
			和凝胶水晶添加制作配方。
			'''
	}

	templeTraps: {
		Label: "[i:1142] 丛林神庙陷阱"
		Tooltip:
			'''
			 如果启用，将为丛林神庙陷阱添加配方。
			'丛林蜥蜴...丛林蜥蜴...丛林蜥蜴...'
			'''
	}

	obsidianFurniture: {
		Label: "[i:2657] 黑曜石家具"
		Tooltip:
			'''
			如果启用，将为地狱房屋中生成的黑曜石家具添加配方。
			'当普通家具不够时尚时'
			'''
	}

	bannerRecipes: {
		Label: "[i:846] 装饰旗配方"
		Tooltip: 如果启用，将为世界中各种建筑物中随机生成的旗帜添加配方。
	}

	teamBlocks: {
		Label: "[i:3636] 彩色团队方块"
		Tooltip: 如果启用，将为各种彩色团队方块及其平台添加配方。'吃瘪吧，旅商！'
	}

	clothierVoodooDoll: {
		Label: "[i:1307] 服装商巫毒娃娃配方"
		Tooltip: 如果启用，玩家可以在恶魔/猩红祭坛上用一个向导巫毒娃娃和一个红帽来制作服装商巫毒娃娃。
	}

	shimmerGuns: {
		Label: "[i:4348] 可微光化的困难模式武器"
		Tooltip:
			'''
			如果启用，狱火球和橙冲击枪可以分别微光分解成喷流球和灰冲击枪。
			否则，在困难模式下是无法获得的。
			'''
	}

	shimmerBlackLens: {
		Label: "[i:236] 可微光化的黑晶状体"
		Tooltip: 如果启用，会将黑晶状体微光分解为晶状体。我不太清楚原因，但你可能会用完晶状体！
	}

	dungeonFurniture: {
		Label: "[i:139] 地牢家具制作配方"
		Tooltip:
			'''
			如果启用，将为所有你通常需要通过掉落获得的地牢家具添加制作配方。
			'对于那些有水平问题的人有帮助'
			'''
	}
}

CalamityUnnerfConfig: {
	DisplayName: 还原灾厄削弱

	Headers: {
		systems: "[i:3097] 系统"
		items: "[i:2218] 物品"
		progression: "[i:1326] 进度"
		itemStats: "[i:368] 物品属性"
		projectileStats: "[i:515] 射弹属性"
		restored: "[i:3456] 恢复功能"
	}

	vanillaEquipStats: {
		Label: "[i:1549] 原版护甲装备属性"
		Tooltip:
			'''
			按理说我该在这里写一大堆废话，但这其实就是恢复原版护甲的属性。
			注意：这些配置项有点敷衍，因为灾厄对原版做了大量无关痛痒的改动，
			如果为每件物品都单独开放配置，条目会轻松突破300个。
			如果你需要更多自定义选项或针对特定物品的配置，尽管来骂我……
			……或者如果你知道怎么更好地整理这堆烂摊子，也请来教我。
			'''
	}

	projPiercing: {
		Label: "[i:515] 原版穿透"
		Tooltip: 启用后，射弹将按原版设定的数量穿透敌人，而非灾厄的平衡数值。
	}

	projArmourPen: {
		Label: "[i:1302] 原版护甲穿透"
		Tooltip: 启用后，射弹将使用原版的护甲穿透数值，而非灾厄的数值。
	}

	projSpeed: {
		Label: "[i:290] 原版射弹速度"
		Tooltip: 启用后，将使用原版的射弹速度，而非灾厄的数值。
	}

	projLifetime: {
		Label: "[i:1321] 原版射弹存在时间"
		Tooltip: 启用后，射弹将使用原版的存续时间。
	}

	projScale: {
		Label: "[i:1444] 原版射弹大小"
		Tooltip: 启用后，射弹将使用原版的尺寸大小。
	}

	projYoyoStats: {
		Label: "[i:3286] 原版悠悠球属性"
		Tooltip:
			'''
			灾厄重新平衡了所有原版悠悠球的射程、最高速度和存在时间。
			启用后，它们将全部恢复为原版数值。
			'''
	}

	projCollision: {
		Label: "[i:497] 原版水体与物块交互"
		Tooltip: 启用后，射弹将完全按照原版的逻辑无视水体并与物块碰撞，而非使用灾厄的设定。
	}

	projTrueMelee: {
		Label: "[i:273] 原版伤害职业"
		Tooltip: 启用后，将移除灾厄新增的伤害职业（如真近战）。说实话，不知道你为什么需要这个，也许你根本不需要。
	}

	itemDamage: {
		Label: "[i:368] 原版物品伤害"
		Tooltip:
			'''
			灾厄重新平衡了数百种原版武器的伤害。启用后，它们将全部恢复为原版的伤害数值。
			这其中既有增强也有削弱。
			'''
	}

	itemCrit: {
		Label: "[i:1248] 原版物品暴击率"
		Tooltip: 启用后，所有物品的暴击率将恢复为原版数值，而非灾厄的数值。
	}

	itemDefence: {
		Label: "[i:1316] 原版护甲防御"
		Tooltip: 启用后，护甲部件将恢复其原版的防御力。
	}

	itemMana: {
		Label: "[i:1595] 原版魔力消耗"
		Tooltip: 启用后，魔法武器的魔力消耗将恢复为原版数值，而不是灾厄认为“应该”有的数值。
	}

	itemSpeed: {
		Label: "[i:211] 原版攻击速度"
		Tooltip:
			'''
			启用后，所有物品的挥舞速度将恢复为原版速度。
			“好东西太多了也是一种折磨啊。（我不到啊，原句My steak is too juicy and my lobster too buttery）”
			'''
	}

	itemShootSpeed: {
		Label: "[i:97] 原版射弹发射速度"
		Tooltip: 启用后，武器将以原版设定的速度发射射弹，而非灾厄的数值。
	}

	itemKnockback: {
		Label: "[i:897] 原版击退"
		Tooltip: 启用后，原版武器将恢复其原本的击退力，而非灾厄的数值。
	}

	itemScale: {
		Label: "[i:536] 原版判定框大小"
		Tooltip: 启用后，近战武器将恢复为原版的尺寸大小（主要是变得更小）。
	}

	itemValue: {
		Label: "[i:855] 原版售价"
		Tooltip:
			'''
			灾厄把一堆原版物品贬得一文不值，并修改了大量其他物品的价格。
			启用后，将恢复原版的经济平衡。
			'''
	}

	itemToolPower: {
		Label: "[i:122] 原版工具属性"
		Tooltip: 启用后，镐、斧和锤的属性将恢复为原版数值，而非灾厄的数值。
	}

	itemBehaviour: {
		Label: "[i:407] 原版物品行为"
		Tooltip:
			'''
			启用后，堆叠上限和一堆杂七杂八的玩意儿也会恢复为原版数值。
			如果你读到了这里，请骂我居然把这种凑数的配置项写了进来。
			'''
	}

	vanillaRecipes: {
		Label: "[i:4457] 恢复原版配方"
		Tooltip: 灾厄删除了迷你核弹I、迷你核弹II和侦察镜的原版制作配方。现在不会了。
	}

	astralDrops: {
		Label: "[i:3460] 星辉敌怪掉落率"
		Tooltip:
			'''
			星辉感染敌怪的武器掉落率从七分之一被砍到了十分之一。
			启用后，掉落率将恢复为七分之一。
			'''
	}

	crateLoot: {
		Label: "[i:2334] 灾厄渔具箱战利品"
		Tooltip:
			'''
			启用后，恢复那些美好的旧版灾厄钓鱼战利品。灾厄想通过删除钓鱼套装来鼓励玩家钓鱼，
			结果转头又把钓鱼给削弱了，就因为钓鱼太好玩了。
			“反反乐趣”
			'''
	}

	shopStock: {
		Label: "[i:1326] 城镇NPC商店库存"
		Tooltip:
			'''
			启用后，将23种物品重新加入城镇NPC的商店，例如混乱之杖、魔法武器、军火商的枪械、
			火箭发射器以及一堆食物。
			“灾厄移除生活质量的的速度比我加回来的速度还快”
			'''
	}

	anglingKits: {
		Label: "[i:3120] 钓鱼套装"
		Tooltip:
			'''
			荒漠灾虫和渊海灾虫以前会各自掉落一袋钓鱼装备，让一条沙漠虫子掉钓鱼装备简直是巅峰级的讽刺。
			灾厄把这两个都删了，理由是让你自己去钓鱼。然后紧接着又把那些好用的渔具箱全删了。呵呵，真是笑死人了。
			启用后，它们会被加回来。
			'''
	}

	earlyCosmolight: {
		Label: "[i:3456] 早期宇宙之光"
		Tooltip:
			'''
			宇宙之光以前是困难模式早期用灵魂制作的。现在它需要白夜之凝和
			幻星锭，这把它锁在了星神游龙之后，大概相当于整个模组三分之二进度的位置。
			启用后，将恢复旧版的制作配方。
			'''
	}

	starterBag: {
		Label: "[i:166] 新手包额外物品"
		Tooltip:
			'''
			新手包以前除了随机的职业武器外，还附带10个炸弹、3个宝箱和一堆药水。
			启用后，这些额外物品会加回来。
			'''
	}

		expertDrops: {
		Label: "[i:3224] 普通模式掉落专家饰品"
		Tooltip:
			'''
			启用后，Boss在普通模式下也会掉落专家模式专属饰品。
			不出所料，灾厄把这个删了。
			'''
	}

	autoswing: {
		Label: "[i:29] 自动挥舞"
		Tooltip:
			'''
			灾厄曾给150种原版物品添加了自动挥舞，然后又以
			1.4.4版本自带该设置为由移除了此功能。然而该设置并不涵盖生命水晶、生命果、魔力水晶或纸飞机。
			启用后，将恢复自动挥舞功能。
			'''
	}

	defenceBonuses: {
		Label: "[i:156] 护盾与护甲防御"
		Tooltip:
			'''
			灾厄以前会给各种饰品增加一点防御力，让它们有点存在的意义。
			例如十字章护盾系列获得+4防御，冰冻海龟壳获得6点防御等。
			启用后，这些增益将恢复。
			'''
	}

	manaDiscounts: {
		Label: "[i:3269] 魔法武器魔力消耗"
		Tooltip:
			'''
			以前有15种原版魔法武器的魔力消耗比原版更低。灾厄“还原了几乎所有
			魔力消耗改动”，这不过是说所有折扣都没了，因为“老子乐意”。
			启用后，将恢复这些折扣。
			“横竖都是我赢。”
			'''
	}

	wingBonuses: {
		Label: "[i:492] 翅膀属性增益"
		Tooltip:
			'''
			我本该在这里写一大堆关于翅膀被怎么“糟蹋”的文字，但你可能已经知道了。
			启用后，它们将重获清白。
			'''
	}

	fireImmunity: {
		Label: "[i:193] 免疫“着火了！”"
		Tooltip:
			'''
			黑曜石头颅系列、十字章护盾和泰拉闪耀靴以前能让你免疫“着火了！”，
			这也是大家佩戴黑曜石头颅的唯一理由。
			看来这位“免疫火焰的零号病人”已经凉了。
			启用后，此改动将被还原。
			'''
	}

	summonSpeed: {
		Label: "[i:1157] 事件召唤物不消耗&召唤速度"
		Tooltip:
			'''
			在旧版灾厄中，所有原版召唤法杖和哨兵杆的攻速都更快，且事件召唤物不消耗。
			我相信你已经看出规律了。
			启用后，这两项改动将被还原。
			'''
	}

	toolPower: {
		Label: "[i:2176] 工具属性与速度"
		Tooltip:
			'''
			灾厄的整个工具重平衡神秘地“消失”了。现在钻头完全弱于镐，而且……
			我甚至懒得把所有东西都写出来。
			启用后，2.0.4版本的数值将回归。简直太棒了。
			'''
	}

	armourBonuses: {
		Label: "[i:1006] 困难模式矿石护甲增益"
		Tooltip:
			'''
			灾厄的“狂野更新”移除了所有有趣且仅*稍微*超模的矿石护甲套装增益。
			启用后，将还原为旧版数值。
			“狂野更新，不如叫温顺更新。”
			'''
	}

	prefixScaling: {
		Label: "[i:1615] 防御词缀成长"
		Tooltip:
			'''
			旧版灾厄对“为什么在游戏后期我还要为了防御去重铸”的回答是：让坚硬、守护、
			装甲和护佑词缀随游戏进度成长。不出所料，这被移除了，因为谁在乎防御呢？
			启用后，此功能将恢复。
			'''
	}

	sicknessContactDamage: {
		Label: "[i:1329] 带有debuff的敌人接触伤害降低"
		Tooltip:
			'''
			带有中毒、剧毒、星辉感染和瘟疫减益的敌人以前会造成降低5%的接触伤害。
			现在只有死亡低语会这样。
			启用后，其他四种减益将重新获得5%的惩罚。
			'''
	}

	nurseAndTaxes: {
		Label: "[npc/n:18] 护士&税收"
		Tooltip:
			'''
			护士从每次固定收费变成了按原版每点生命值价格乘以最高约600倍收费。
			税务官的税率则向另一个方向削减，现在只支付一半到四分之一的金额。
			启用后，这些改动将被还原，她在死亡模式或Boss Rush中不会治疗你，而税务官将再次收取每个NPC1银币50铜币。
			“人生中唯一确定的事就是护士和税收。”
			'''
	}

	spawnRates: {
		Label: "[i:288] 生成率修正"
		Tooltip:
			'''
			灾厄以前会重新平衡生成药水的生成率。这被删除了，我找不到任何合理的理由。
			启用后，旧版数值将再次生效。
			'''
	}

	sellPrices: {
		Label: "[i:74] 灾厄售价"
		Tooltip:
			'''
			灾厄以前因为其装备强得离谱，所以售价也更高。这已经被削弱到谷底了。
			启用后，就不会这样了。
			'''
	}

	shieldImmunities: {
		Label: "[i:1613] 护盾减益免疫"
		Tooltip:
			'''
			阿斯加德之英勇以前由十字章护盾制作，并继承了其减益免疫效果。
			整个华丽护盾系列也失去了所有免疫效果，配方也不再需要十字章护盾，好好享受这俩玩意占你俩饰品槽吧。
			启用后，免疫效果和进行圣火冲刺时造成神圣之火减益的效果将被重新加入，
			阿斯加德之英勇也将再次需要十字章护盾制作。
			“如果你把所有东西都移除了，还能剩下什么？”
			'''
	}

	soaringInsignia: {
		Label: "[i:4989] 翱翔徽章反削弱"
		Tooltip: 启用后，撤销灾厄对翱翔徽章奔跑加速度的削弱，并恢复无限飞行。
	}

	meteorArmour: {
		Label: "[i:123] 流星套反削弱"
		Tooltip:
			'''
			灾厄更改了流星套的套装增益：你失去了太空枪的免费魔力，
			转而获得所有魔法枪33%的魔力消耗减免。这算不上削弱，但也不再是那个有趣的增益了，所以这里提供一个还原 ;)
			'''
	}

	blackBelt: {
		Label: "[i:963] 黑腰带反削弱"
		Tooltip:
			'''
			启用后，禁用灾厄为黑腰带添加的90秒共享冷却时间。
			“为了闪避之神而闪避。”
			'''
	}

	brainOfConfusion: {
		Label: "[i:3223] 混乱之脑反削弱"
		Tooltip:
			'''
			启用后，禁用灾厄为混乱之脑添加的90秒共享冷却时间。
			“为了闪避之神而闪避。”
			'''
	}

	shadowArmour: {
		Label: "[i:86] 暗影套反削弱"
		Tooltip:
			'''
			启用后，撤销灾厄对暗影套的削弱。它降低了移动速度加成，然后还决定它不应该与
			魔光护符叠加。
			'''
	}

	damageReduction: {
		Label: "[i:3224] 减伤反削弱"
		Tooltip:
			'''
			灾厄悄悄地将你所有的减伤通过一个公式计算，所以25%变成了20%，50%变成了33%，
			而100%变成了50%。启用后，我们将恢复原版减伤机制。
			'''
	}

	bossDR: {
		Label: "[i:3097] 原版Boss减伤反削弱"
		Tooltip:
			'''
			灾厄给22个原版Boss添加了固定的减伤，大概是为了防止Boss被杀得太快。
			这有点拉胯，所以如果启用此选项，直接 Y E E T（扔飞）。
			我想念那个写搞笑配置信息的孩子 :(
			'''
	}

	calamityBossDR: {
		Label: "[i:3097] 灾厄Boss减伤反削弱"
		Tooltip:
			'''
			启用后，灾厄Boss也将禁用相同的固定减伤。
			公平地说，如果你这样做，有些Boss会变得轻而易举就能逃课。
			'''
	}

	pierceResist: {
		Label: "[i:3029] 穿透射弹反削弱"
		Tooltip:
			'''
			世界吞噬怪、克苏鲁之脑的爬行者以及毁灭者每次被穿透射弹命中时，都会损失12%的伤害，上限为-80%。
			启用后，此机制将被移除。
			'''
	}

	lifesteal: {
		Label: "[i:1569] 吸血恢复反削弱"
		Tooltip:
			'''
			泰拉瑞亚有一个隐藏的吸血条，在经典模式下以36点/秒的速度恢复，专家模式下为30点/秒。
			灾厄让它变得没那么有效了，分别降低到9点/秒和6点/秒，并且如果你的生命值超过最大值的50%，就无法通过吸血恢复。
			启用后，将撤销此削弱。
			顺便说一句，Wiki也在骗你，它说这不再把吸血削弱到谷底了。但这已经被我亲自核实打脸了 :P
			'''
	}

	meleeArmourDR: {
		Label: "[i:2218] 甲虫套与日耀套减伤反削弱"
		Tooltip: 启用后，甲虫壳和日耀套将恢复其原版的乘法减伤，而非固定数值。
	}

	buffs: {
		Label: "[i:353] 永久增益反削弱"
		Tooltip:
			'''
			启用后，移除灾厄对一堆状态效果的改动：
			“酒足饭饱”提供20%速度而非5%，“魔力强化”提供20%而非10%，
			“箭术”提供10%伤害而非5%，“灵视”提供5%魔法伤害而非3%，
			“迅捷”提供25%速度而非15%，“挖矿”提供25%挖矿速度而非15%，
			“糖果冲刺”提供20%速度和20%挖矿速度，而非各10%。
			“微醺”最搞笑，因为灾厄让它没有近战伤害、没有暴击，还有10%*更差*的近战速度，
			而原版是用4点防御换取+10%近战伤害、+2%暴击和+10%近战速度。
			顺便说一下，提示文本也修复了。
			'''
	}

	damageVariance: {
		Label: "[i:3119] 伤害浮动反削弱"
		Tooltip:
			'''
			启用后，恢复原版的伤害浮动机制。灾厄将其大幅缩小，并完全移除了运气的影响。
			“电子竞技并不意味着没有随机性的对称对局。”
			'''
	}

	multiplayerBossHealth: {
		Label: "[i:29] 多人模式Boss血量反削弱"
		Tooltip: 启用后，还原灾厄对多人模式Boss血量的增强。也许当肉盾不好玩？
	}

	meleeResist: {
		Label: "[i:273] 近战抗性反削弱"
		Tooltip:
			'''
			近战武器对世界吞噬怪和克苏鲁之脑的飞眼怪造成的伤害减少25%，对毁灭者造成一半伤害。
			启用后，这将被还原，因为这实际上就是给懦夫加的Boss血量增益。
			'''
	}

		ichorDefence: {
		Label: "[i:1332] 灵液反削弱"
		Tooltip:
			'''
			原版灵液会降低敌人15点防御。灾厄悄悄把它削弱到了10点，但提示文本里还写着15。
			启用后，灵液将再次做到“名副其实”。
			'''
	}

	hallowedDodge: {
		Label: "[i:553] 神圣闪避反削弱"
		Tooltip:
			'''
			灾厄的冷却系统给神圣盔甲的闪避强加了一个30秒的冷却时间。
			启用后，此改动将被还原。
			'''
	}

	wingAscent: {
		Label: "[i:749] 翅膀上升速度反削弱"
		Tooltip:
			'''
			蝴蝶之翼和幽灵之翼的上升速度被削弱，以换取更好的加速度。
			启用后，此改动将被还原。（这算不上严格意义的削弱，更像是重做，因此默认不启用）
			'''
	}

	shieldBonkSafety: {
		Label: "[i:3097] 克苏鲁护盾撞击反削弱"
		Tooltip:
			'''
			在克苏鲁护盾冲刺期间，你理应免疫撞击造成的伤害。
			直到灾厄跑出来，把最后4帧的无敌帧给砍了，所以你就乖乖挨打吧。
			启用后，整个冲刺过程将再次提供无敌。
			'''
	}

	shimmerGating: {
		Label: "[i:1326] 微光液体处理反削弱"
		Tooltip: 启用后，微光液体将不再检查你的Boss图鉴进度。
	}

	bloodMoonRequirement: {
		Label: "[i:4271] 血月条件反削弱"
		Tooltip: 灾厄大幅提高了血月的触发条件。启用后，此改动将被还原。
	}

	fossilShattering: {
		Label: "[i:3380] 化石碎裂反削弱"
		Tooltip:
			'''
			沙漠化石从高处落下时会碎裂成坚固化石。灾厄把这删了。
			启用后，化石将再次碎裂。
			'''
	}

	classConversions: {
		Label: "[i:3806] 职业转换反削弱"
		Tooltip:
			'''
			武僧T2和T3套装以及水晶刺客套装被改成了盗贼护甲。
			启用后，此改动将被还原。
			默认关闭，因为这算是重做而不是削弱，而且说不定有人正玩到一半的盗贼档呢。;)
			'''
	}

	summonerCrossClass: {
		Label: "[i:1157] 召唤师跨职业反削弱"
		Tooltip:
			'''
			如果你手持任何非召唤武器，你的仆从伤害会被削弱25%。
			灾厄自己的召唤武器不受此限制，所以实际上这就是对使用原版召唤武器的惩罚。
			启用后，这个脑残机制将被还原。
			'''
	}

	balloonJump: {
		Label: "[i:159] 气球跳跃反削弱"
		Tooltip:
			'''
			气球原本应该同时增加你的跳跃高度和跳跃速度。灾厄直接把
			高度加成删了个干净，速度加成也变成了可怜的+0.75。
			启用后，将恢复原版数值。
			'''
	}

	beetleMight: {
		Label: "[i:2200] 甲虫力量反削弱"
		Tooltip:
			'''
			原版中，甲壳护胫每拥有一只甲虫，就能提供10%近战伤害和10%近战速度。
			灾厄悄悄把速度加成砍半到了5%，对于一套纯粹为近战而生的套装来说，真是“太棒了”。
			启用后，原版的10%将再次恢复。
			'''
	}

	scopes: {
		Label: "[i:1858] 瞄准镜反削弱"
		Tooltip: 启用后，将恢复狙击镜和侦察镜的数值。
	}

	spectreAndVampire: {
		Label: "[i:1446] 幽魂与吸血鬼吸血反削弱"
		Tooltip:
			'''
			启用后，将关闭灾厄对幽魂套和吸血鬼刀吸血机制的重做。
			出于显而易见的原因，默认不启用。
			'''
	}

	asphaltAndSkates: {
		Label: "[i:775] 沥青与溜冰鞋反削弱"
		Tooltip: 启用后，将恢复沥青块和溜冰鞋的原版速度/加速度数值。
	}

	nebulaArmour: {
		Label: "[i:2760] 星云套反削弱"
		Tooltip:
			'''
			启用后，移除灾厄对星云套的削弱。
			到了这一步，我连写吐槽的灵感都没了。
			'''
	}

	meleeSpeedStacking: {
		Label: "[i:1343] 近战速度叠加反削弱"
		Tooltip:
			'''
			近战手套类，日月石和天界石/天界壳不再叠加效果。
			启用后，它们将像原版那样正常叠加。
			'''
	}

	whipTagCrits: {
		Label: "[i:4679] 鞭子标记暴击反削弱"
		Tooltip:
			'''
			启用后，将恢复晨星和万花筒的鞭子召唤物标记暴击机制。
			我猜有些灾厄开发者讨厌这些鞭子，尽管他们自己也没加什么新鞭子？
			'''
	}

	terrarianProjectiles: {
		Label: "[i:3389] 泰拉悠悠球反削弱"
		Tooltip:
			'''
			泰拉悠悠球的特色就是扔出多得离谱的悠悠球。灾厄限制了同时存在的数量，
			这简直就像是因为天顶剑的剑太多而把它削弱了一样。（哦等等，他们已经把它锁进度了……）
			启用后，此改动将被移除。
			'''
	}

	immunityFrames: {
		Label: "[i:554] 无敌帧反削弱"
		Tooltip:
			'''
			启用后，移除灾厄对数百种原版射弹无敌帧的改动。
			它通过把它们放入共享冷却时间，来防止射弹伤害叠加。
			'''
	}

	jungleArmour: {
		Label: "[i:228] 丛林套反削弱"
		Tooltip: 启用后，将灾厄对丛林套装的削弱还原为原版属性。
	}

	frostArmour: {
		Label: "[i:684] 寒霜套反削弱"
		Tooltip: 启用后，将恢复原版寒霜套装的属性。公平地说，这更像是重做而不是削弱。
	}

	yoyoGlove: {
		Label: "[i:3334] 悠悠球手套反削弱"
		Tooltip:
			'''
			启用后，还原灾厄对悠悠球手套提供的副悠悠球伤害50%的削弱。
			“给乐趣警察的一记重拳。”
			'''
	}

	defenseDamage: {
		Label: "[i:156] 移除防御损伤"
		Tooltip:
			'''
			启用后，禁用灾厄的“防御损伤”机制，该机制旨在阻止玩家无脑站撸。
			唯一的问题是，无脑站撸Boss真的很好玩，而且这又不是东方Project。
			注意：这会让血炎核心变得毫无用处，我警告过你了哦 ;)
			'''
	}
}

CalamityQoLConfig: {
	DisplayName: 灾厄生活质量

	Headers: {
		gameplay: "[i:3515] 游戏玩法"
		playerBoosts: "[i:54] 玩家增强"
		recipes: "[i:36] 配方"
	}

	fullExpertRegen: {
		Label: "[i:1787] 生命恢复不挨饿"
		Tooltip:
			'''
			启用后，专家模式将不再因为你没有“酒足饭饱”而让你的生命恢复速度减半。
			顺便说一句，游戏从来没告诉过你它会这么干，Wiki游戏真是绝了。
			'''
	}

	starterBag: {
		Label: "[i:1774] 新手包"
		Tooltip:
			'''
			启用后，新角色将获得一个包含你原本打算花十分钟去制作的那套装备的包。
			右键打开。里面有绳子，所以请不要问“为什么没绳子”或“为什么没钩爪”。
			'''
	}

	fasterMovement: {
		Label: "[i:212] 更快的基础移速"
		Tooltip:
			'''
			启用后，没有赫尔墨斯之靴时你的移动速度也会提升50%，专为讨厌前期的你准备。
			如果加载了泰拉大修（Terraria Overhaul）会自动关闭，因为它本身就会大修移动系统。
			'''
	}

	higherJumpHeight: {
		Label: "[i:2423] 更高跳跃"
		Tooltip: 启用后，你的基础跳跃高度从5.01提升到5.51，实际体验中大概能多跳一个物块。
	}

	fasterJumpSpeed: {
		Label: "[i:159] 更快跳跃"
		Tooltip: 启用后，你的跳跃速度提升4%（装备翅膀时提升24%）。
	}

	fasterTilePlacement: {
		Label: "[i:2214] 更快的建筑"
		Tooltip: 启用后，你放置物块和墙壁的速度将大幅提升。
	}

	fasterFall: {
		Label: "[i:716] 按住下键加速下落"
		Tooltip: 启用后，在半空中按住下键会使重力翻倍（最大下落速度不变）。
	}

	vanillaRecipeTweaks: {
		Label: "[i:1006] 更便宜的原版配方"
		Tooltip:
			'''
			启用后，一堆原版配方将不再恶心人。
			- 小丑之箭和传送药水可以批量制作。
			- 叶绿锭和蘑菇矿锭需要更少的矿石。
			- 真·永夜刃只需要3个机械Boss灵魂，而不是20个。
			- 困难模式早期的物品不再需要秘银砧。
			- 狱岩锭和甲壳护胫的配方中，武器会排在矿石前面，因为反过来排客观上就是错的。
			'''
	}

	evilBiomeSwaps: {
		Label: "[i:3224] 腐化与猩红掉落物互换"
		Tooltip:
			'''
			启用后，你可以在墓地中将任何腐化掉落物换成对应的猩红掉落物，反之亦然。
			例如蠕虫围巾换混乱之脑、火枪换送葬者等。
			“我实在决定不了到底要腐化还是猩红。”
			'''
	}

	earlyWeaponRecipes: {
		Label: "[i:65] 早期武器配方"
		Tooltip:
			'''
			启用后，为那些原本纯靠运气的早期武器添加配方，例如附魔剑、星怒、
			水箭魔法书、史莱姆法杖、雀杖等。
			'''
	}

	accessoryRecipes: {
		Label: "[i:54] 饰品配方"
		Tooltip:
			'''
			启用后，为那些你本该在地下找到的饰品添加配方。
			（赫尔墨斯之靴、云朵瓶、幸运马掌、熔岩护符、黑曜石玫瑰等）
			“前50次确实挺搞笑的。”
			'''
	}

	armourRecipes: {
		Label: "[i:804] 护甲配方"
		Tooltip: 启用后，为爱斯基摩套装添加配方。
	}

	summonRecipes: {
		Label: "[i:43] 召唤配方"
		Tooltip: 启用后，为血泪和雪球仪添加配方。
	}

	miscRecipes: {
		Label: "[i:4346] 杂项配方"
		Tooltip:
			'''
			启用后，为负重石、巴斯特雕像、生命水晶、魔法海螺、雨伞以及
			游戏中的所有墓碑添加配方。看啊老妈，居然真的有人想要这些墓碑。

			“写搞笑吐槽的沉重负担”
			'''
	}

	shimmerRecipes: {
		Label: "[i:5364] 额外微光转化"
		Tooltip: 启用后，三种信息配饰可以互相转化，附魔剑和泰拉魔刃同理。
	}
}
