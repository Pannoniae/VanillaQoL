QoLConfig: {
	DisplayName: 生活质量配置

	townNPCsSpawningAtNight: {
		Label: "[i:4951] 允许城镇NPC在夜间重生"
		Tooltip: 如果启用，城镇NPC也可以在夜间生成。
	}

	townNPCsMovingAtDay: {
		Label: "[i:4951] 允许城镇NPC在白天传送"
		Tooltip: 如果启用，城镇NPC可以在白天传送到他们的房子。
	}

	betterCensus: {
		Label: "[i:25] 城镇NPC清单"
		Tooltip:
			'''
			启用后，将在房屋菜单中显示所有尚未入住的城镇NPC及其等待条件。
			绿色对勾表示已满足入住条件。红色叉号表示尚未满足。紫色问号表示未知。
			'''
	}

	npcHappinessOnHover: {
		Label: "[i:58] 悬停显示NPC幸福度"
		Tooltip:
			'''
			启用后，你可以在房屋菜单中悬停已入住的NPC，查看他们的物价以及喜爱、喜欢和讨厌的事物与NPC。
			再也不用像税务审计员一样，翻三个菜单去盘问每个村民了。
			'''
	}

	censusSpoofing: {
		Label: "[i:267] 兼容人口普查"
		Tooltip: 启用后，通过模拟人口普查模组，为其他模组及其Mod.Calls提供支持。
	}

	npcLocatingArrow: {
		Label: "[i:393] NPC地理藏宝"
		Tooltip: 启用后，你可以在房屋菜单中悬停已入住的NPC，将会出现一个箭头指向他们所在的位置。
	}

	npcArrowColour: {
		Label: "[i:1071] NPC地理藏宝箭头颜色"
		Tooltip: 涂成黑色！
	}

	censusSpoilerMode: {
		Label: "[i:1307] 无剧透NPC人口普查"
		Tooltip:
			'''
			启用后，将隐藏清单提示中的入住条件，这样你只能看到谁还没来，而不知道如何召唤他们。
			“泰拉瑞亚：反Wiki版”
			'''
	}

	townPetsInvincible: {
		Label: "[i:4829] 城镇宠物和史莱姆是无敌的"
		Tooltip: 如果启用，萌萌的城镇动物和史莱姆就不会被敌人或boss伤害。
	}

	Headers: {
		information: "[i:3095] 信息"
		gameplay: "[i:3515] 游玩"
		fixes: "[i:3625] 修复"
		content: "[i:757] 内容"
		craftableUncraftables: "[i:36] 制作不可制作的"
		respawn: "[i:708] 重生"
		suffering: "[npc/n:369] 受苦"
		multiplayer: "[i:181] 多人"
		holidayCheer: "[i:602] 节日庆祝"
		cheats: "[i:3999] 作弊"
		testing: "[i:2] 测试"
		tweaks: "[i:1344] 调整"
		combat: "[i:757] 战斗"
		recipes: 配方标题
		npcs: "[npc/n:178] NPC调整"
	}

	showHookTooltips: {
		Label: "[i:185] 显示钩爪工具提示"
		Tooltip: 如果启用，钩爪会在工具提示中显示它们的射程以及爪钩数量。
	}

	showWingTooltips: {
		Label: "[i:1162] 显示翅膀工具提示"
		Tooltip: 如果启用，翅膀会在工具提示中显示飞行时间和水平速度。
	}

	ammunitionTooltips: {
		Label: "[i:4915] 显示子弹工具提示"
		Tooltip: 如果启用，远程武器会显示它们发射的弹药类型。
	}

	shimmerableTooltip: {
		Label: "[i:5348] 可微光工具提示"
		Tooltip: 如果启用，物品工具提示中会显示被扔进微光后转化成的物品。
	}

	worldAndPlayerInfo: {
		Label: "[i:393] 在选择界面上显示信息"
		Tooltip: 如果启用，选择世界界面和选择玩家界面上会显示有用的信息，比如一个世界是否处于困难模式，已经使用了哪些升级等。
	}

	fixPvPUI: {
		Label: "[i:181] 修复团队图标位置"
		Tooltip:
			'''
			当安装了许多城镇NPC的mod时，团队和PvP图标会覆盖NPC的图标。
			如果启用，图标会被移动以避免重叠。
			'''
	}

	fixMemoryLeaks: {
		Label: "[i:1344] 修复魔法储存"
		Tooltip: 如果启用，修复在启用魔法存储的情况下游戏无法启动或在"加载内容"界面卡住的问题。
	}

	fasterModLoading: {
		Label: "[i:3099] 更快的模组加载"
		Tooltip:
			'''
			tModLoader 有一个绝妙的循环机制，本应在加载界面加速纹理加载。但由于一个拼写错误，它从未运行过。
			启用此项后，我们将修补加载界面使其真正生效，从而大幅加快模组加载速度——因为没人喜欢干等着。
			'''
	}

	vanillaThoriumTooltips: {
		Label: "[i:3572] 原版瑟银工具提示"
		Tooltip:
			'''
			与泰拉瑞亚的工具提示相比，瑟银模组中的许多工具提示看起来不太合适。
			如果启用，这个选项会让它们更贴近基础游戏的风格。
			'''
	}

	removeThoriumEnabledCraftingTooltips: {
		Label: "[i:666] 删除瑟银中不必要的配方条件"
		Tooltip:
			'''
			瑟银为捐赠者物品添加了一个"在瑟银模组配置中启用"的条件。
			在魔法存储和合成表模组中，文本太长了，而且完全没有必要。
			如果启用此选项，将从制作物品的描述中删除这些文本。
			'''
	}

	invertRecipeListScrolling: {
		Label: "[i:36] 反转配方列表滚动"
		Tooltip: 如果启用，配方列表会向正确方向滚动。
	}

	metricSystem: {
		Label: "[i:393] 使用公制系统"
		Tooltip: 你像世界上96%的人一样使用公制吗？如果启用，单位将以公制显示。
	}

	twentyFourHourTime: {
		Label: "[i:709] 24小时制"
		Tooltip: 你像世界上96%的人一样使用公制吗？如果启用，时钟将显示24小时制时间。
	}

	showLuck: {
		Label: "[i:4361] 显示运气统计"
		Tooltip: 如果启用，金属探测器（或其升级）会显示你的运气。
	}

	disableShimmerPumping: {
		Label: "[i:581] 修复微光可被水泵移动"
		Tooltip: 如果启用，在击败月亮领主之前，禁用使用水泵移动微光，以防止微光过早移动。
	}

	autoJoinTeam: {
		Label: "[i:181] 自动加入多人游戏团队"
		Tooltip: 如果启用，当加入多人游戏服务器时，游戏会自动加入所选的团队。
	}

	teamToAutoJoin: {
		Label: "[i:182] 自动加入团队"
		Tooltip: 选择自动加入哪个团队。
	}

	mapSharing: {
		Label: "[i:893] 地图共享"
		Tooltip:
			'''
			再也不用担心地图被损坏了！启用后，已探索的地图区域会自动同步给其他玩家。
			简直太棒了。
			'''
	}

	mapSharingTeamOnly: {
		Label: "[i:893] 地图共享仅限同队伍"
		Tooltip: 启用后，共享地图仅在队伍内同步。非常适合PvP和/或爱窥探的朋友。
	}

	overTimeNurseHealing: {
		Label: "[npc/n:18] 修复护士治疗"
		Tooltip: 如果启用，护士会随着时间为玩家恢复生命，以避免玩家滥用她的治疗功能。
	}

	nurseHealingTime: {
		Label: "[i:73] 护士治疗时间"
		Tooltip: 控制护士应该为玩家治疗多长时间。数值越大，治疗速度就越慢。
	}

	disableTownSlimes: {
		Label: "[npc/n:670] 禁用城镇史莱姆"
		Tooltip: 这个选项会禁用城镇史莱姆。当你进入游戏世界时，会杀死那些可怜的小动物，你这个怪物。
	}

	ancientSwords: {
		Label: "[i:757] 启用旧版本的剑"
		Tooltip:
			'''
			如果启用，它会添加在1.4.4版本中被重新设计的剑的古老版本，使其更偏向于投掷武器。
			把经典的永夜刃和泰拉刃还给我！
			'''
	}

	enableLockOn: {
		Label: "[g:1] 启用锁定功能"
		Tooltip: 如果启用，将在鼠标和键盘上启用锁定模式。需要重新启动。
	}

	lockOn: {
		Label: "[g:1] 锁定"
		Tooltip: 如果启用，允许在使用鼠标和键盘时使用锁定功能。
	}

	moreBuffSlots: {
		Label: "[i:292] 更多增益栏"
		Tooltip: 根据此配置项的值增加增益栏的数量。设置为0则禁用。
	}

	queenBeeLarvaeBreak: {
		Label: "[i:1133] 更不容易死亡的幼虫"
		Tooltip: 如果启用，幼虫将不再能被随意的挥剑或子弹击破，只能被镐击破。
	}

	disablePrefixChangingRarity: {
		Label: "[i:398] 禁用前缀更改稀有度"
		Tooltip: 如果启用，重铸的物品不会改变稀有度。不适用于现有物品。
	}

	softDungeonBricks: {
		Label: "[i:139] 柔软的地牢砖"
		Tooltip: 如果启用的话，地牢砖对你来说太软了，就像你这个小软蛋一样。
	}

	assetFix: {
		Label: "[i:38] 在Linux上修复DragonLens"
		Tooltip:
			'''
			如果启用，Vanilla+ QoL 会更改泰拉瑞亚文件的大小写。这修复了几个试图加载文件但对大小写敏感的模组。
			这是因为Linux上的文件系统区分大小写，所以"Projectile"和"projectile"是两个不同的文件。
			(在启用此功能后，你需要重新启动游戏以防止错误发生。)
			'''
	}

	accessorySlotUnlock: {
		Label: "[i:3335] 解锁专家/大师模式的饰品栏位"
		Tooltip:
			'''
			如果启用，在每个难度下，所有的饰品栏位都可以解锁。
			在经典模式下，你仍然无法从血肉墙获得恶魔之心，你必须使用专家模式的世界。
			'''
	}

	drillRework: {
		Label: "[i:2774] 钻头重做"
		Tooltip:
			'''
			如果启用，钻头将被重新设计，以便能够获得近战速度的修饰语，并能够从采矿速度中受益。
			另外，他们还可以一下就挖掉草。
			作为交换，他们的基础速度降低了，只获得25%的采矿速度提升，而不是60%。
			'''
	}

	sliceOfCakeUntilDeath: {
		Label: "[i:3750] 一片蛋糕吃到死"
		Tooltip: 如果启用，蛋糕块给予的增益效果将持续到玩家死亡，而不是两分钟。
	}

	deathLessBuffs: {
		Label: "[i:487] 死亡后保留持续增益效果"
		Tooltip: 如果启用，玩家死亡时不会移除持续性增益（如施法桌或蛋糕块等增益）。
	}

	wallsDontExplode: {
		Label: "[i:1101] 防爆墙"
		Tooltip: 如果启用，神庙墙和地牢墙（包括安全和不安全的）都具有防爆特性，就像它们的方块对应物一样。
	}

	hardModeOresCanExplode: {
		Label: "[i:1106] 困难模式矿石能被炸掉"
		Tooltip: 如果启用，在击败机械boss后，可以使用炸药炸开困难模式矿石。
	}

	meteoriteCanExplode: {
		Label: "[i:117] 陨石可爆破"
		Tooltip:
			'''
			启用后，陨石可以在困难模式之前使用炸药炸毁，而不是仅困难模式可爆破。

			'''
	}

	dynamicDCUPickaxe: {
		Label: "[i:2768] 动态钻头控制装置"
		Tooltip: 如果启用，钻头控制装置会考虑你背包栏中左上角的镐的镐力。
	}

	moreExplosives: {
		Label: "[i:VanillaQoL/BouncyDirtDynamite] 更多爆炸物"
		Tooltip: 如果启用，会在游戏中增加更多种类的爆炸物。
	}

	respawningRework: {
		Label: "[i:889] 重生机制重制"
		Tooltip: 如果启用，将启用此部分中的调整。
	}

	naturesGiftGlow: {
		Label: "[i:223] 大自然的恩赐和丛林玫瑰发光"
		Tooltip: 如果启用，大自然的恩赐和丛林玫瑰在丛林中会像丛林孢子一样发光，使它们更容易被发现。
	}

	respawnTime: {
		Label: "[i:3230] 重生时间"
		Tooltip: 控制基础重生时间。
	}

	respawnFactorExpertMode: {
		Label: "[i:3223] 专家模式因素"
		Tooltip: 控制专家模式重生时间乘数。
	}

	respawnFactorMasterMode: {
		Label: "[i:4924] 大师模式因素"
		Tooltip: 控制大师模式重生时间乘数。
	}

	bossRespawnTime: {
		Label: "[i:43] BOSS战时重生时间"
		Tooltip: 控制在boss存活时的基础重生时间。
	}

	eventRespawnTime: {
		Label: "[i:1844] 事件时重生时间"
		Tooltip: 控制在boss未存活但事件仍在进行时的基础重生时间。
	}

	bossMultiplayerMultiplier: {
		Label: "[i:1969] 每位玩家的时间乘数"
		Tooltip: 将重生时间乘以这个值，再乘以服务器上其他玩家的数量。
	}

	christmasAllYear: {
		Label: "[i:1872] 启用圣诞节"
		Tooltip: 如果启用的话，圣诞精神可以贯穿全年。
	}

	halloweenAllYear: {
		Label: "[i:1813] 启用万圣节"
		Tooltip: 如果启用，逝去的灵魂的幽灵全年都会出现。
	}

	shopExpander: {
		Label: "[i:73] 商店扩展"
		Tooltip: 如果启用，Vanilla+ QoL 会在商店中添加页面，以容纳所有物品，您可以使用两个按钮在这些页面之间切换。
	}

	extraSellPages: {
		Label: "[i:72] 额外售卖页面"
		Tooltip: 如果启用，当商店通过出售物品而满员时，会创建一个新页面来扩展商店。
	}

	lifeCrystalGlow: {
		Label: "[i:29] 生命水晶发光"
		Tooltip: 如果启用，生命水晶会发出微弱的光芒，使它们更容易被发现。
	}

	lifeFruitGlow: {
		Label: "[i:1291] 生命果发光"
		Tooltip: 如果启用，生命果会像丛林孢子一样发光，使它们更容易被发现。
	}

	NPCsLiveInEvilBiomes: {
		Label: "[i:8] NPC可以在邪恶生物群落中生存"
		Tooltip:
			'''
			如果启用，NPC会勉强容忍腐化和猩红。
			尽管如此，他们仍然会非常讨厌你，他们会非常不开心。不要那么残忍。
			'''
	}

	disableBiomeSpread: {
		Label: "[i:199] 禁用生物群落扩散"
		Tooltip:
			'''
			如果启用的话，像猩红、腐化和神圣这样的感染性生物群落就不会扩散。
			'你的末日还没有到来。'
			'''
	}

	noDroppedSand: {
		Label: "[i:169] 没有落沙"
		Tooltip: 如果启用，蚁狮不会用沙子污染你的世界，而是以物品的形式掉落。
	}

	noDroppedSnow: {
		Label: "[i:593] 没有落雪"
		Tooltip: 如果启用，雪人不会用雪污染你的世界，而是以物品的形式掉落雪。
	}

	noDroppedTombstones: {
		Label: "[i:1175] 没有掉落的墓碑"
		Tooltip:
			'''
			如果启用，墓碑将作为物品掉落，而不是直接生成一个墓碑。
			'对于那些有水平问题的人很有帮助'
			'''
	}

	noDroppedSandgun: {
		Label: "[i:266] 没有落沙（沙枪）"
		Tooltip:
			'''
			如果启用，沙枪在使用时不再放置沙子。
			如果你启用这个功能，你应该会觉得很不好意思，因为这会让沙枪变得非常强大。
			'''
	}

	mountFallDamage: {
		Label: "[i:2430] 不会受到坠落伤害"
		Tooltip: 如果启用了这个功能，你在骑乘任何坐骑时都不会受到坠落伤害。
	}

	disableShimmering: {
		Label: "[t:VanillaQoL/UI/Shimmer] 不会掉入微光中"
		Tooltip: 如果启用了这个功能，当你掉入微光区域时就不会穿透世界了。你可以在里面洗澡哦 :)
	}

	modNameTooltip: {
		Label: "[i:2208] 模组名称工具提示"
		Tooltip: 如果启用，物品在其工具提示中会显示它们来自哪个模组。
	}

	testing: {
		Label: "[i:2] 测试"
		Tooltip: 如果你启用这个功能，做好最坏的准备:)
	}

	jungleMimic: {
		Label: "[npc/n:476] 丛林宝箱怪在困难模式的丛林中生成。"
		Tooltip: 如果启用，您的地下丛林体验将通过丛林宝箱怪得到增强。
	}

	clownExplosions: {
		Label: "[npc/n:109] 小丑开心炸弹摧毁物块"
		Tooltip: 如果启用，小丑投掷的快乐炸弹会在一次小型爆炸中摧毁物块。
	}

	naturalFrostLegion: {
		Label: "[i:602] 雪人军团自然生成"
		Tooltip: 如果启用，雪人军团可以在发生暴风雪的夜晚随机出现。
	}

	enemiesBreakDoors: {
		Label: "[i:25] 敌人砸门"
		Tooltip: 如果启用，敌人不会只是礼貌地敲门，而是会像哥布林那样直接破门而入。
	}

	nonConsumableSummons: {
		Label: "[i:43] Boss召唤物不消耗"
		Tooltip: 如果启用，Boss召唤物不会消耗。
	}

	veinMining: {
		Label: "[i:385] VeinMining™"
		Tooltip: 如果启用，开采一块矿石会同时开采相邻的矿石。
	}

	veinMiningSpeed: {
		Label: "[i:3509] VeinMining™ 速度"
		Tooltip: 控制物块破碎之间的延迟。数值越低，脉矿开采速度越快。
	}

	extendedOres: {
		Label: "[i:424] 扩展矿石™ 科技"
		Tooltip: 如果启用，我们的商标和专利技术将为VeinMine™添加新的、令人兴奋且富有影响力的矿石！
	}

	wingSlot: {
		Label: "[i:1162] 翅膀栏™"
		Tooltip: 如果启用，玩家将获得一个翅膀栏。只有翅膀可以放入这个槽中。
	}

	moveCredits: {
		Label: "[i:5044] 鸣谢"
		Tooltip: 控制游戏结束时的片尾字幕如何显示。
	}

	axeReplanting: {
		Label: "[i:3506] 斧头重新种植橡实"
		Tooltip: 如果启用了，用斧头砍倒一棵树后会自动在原地重新种植一颗橡实。
	}

	ninja: {
		Label: "[i:256] 忍者"
		Tooltip: 如果启用，将添加一个忍者NPC。在击败史莱姆王后可以救出他。
	}

	quickBuffFavourite: {
		Label: "[i:289] 快速增益只使用已收藏的药水"
		Tooltip: 如果背包栏中有收藏的药水，快速增益功能只会消耗那些被收藏的药水。
	}

	noFullHeartPickup: {
		Label: "[i:58] 在生命满时不要消耗心"
		Tooltip: 如果启用且玩家生命值已满，他们就不会拾取心。同样，如果玩家魔力值已满，他们就不会拾取星星。
	}

	heartTime: {
		Label: "[i:58] 心消失时间"
		Tooltip: 控制心和星星在消失前在世界中存在的时间，单位为秒。默认值是300，即5分钟。
	}

	calamityInWorldRarity: {
		Label: "[t:VanillaQoL/UI/Wrench] 灾厄稀有度修复"
		Tooltip: 如果启用，灾厄武器的稀有度颜色将在拾取文本中或物品掉落在游戏世界中时正确显示。
	}

	cactusHurts: {
		Label: "[i:276] 仙人掌伤害玩家"
		Tooltip: 如果启用，触摸仙人掌会造成10点伤害，就像在1.1版本中一样。
	}

	jungleThornsAreSticky: {
		Label: "[i:210] 粘的灌木"
		Tooltip: 如果启用，灌木会像蜘蛛网一样减慢玩家的速度。
	}

	drShield: {
		Label: "[i:156] 盾牌上的伤害减免"
		Tooltip: 如果启用，防御盾牌（饰品栏左边的盾牌）也会显示伤害减免属性。
	}

	stopSantaFromExploding: {
		Label: "[i:588] 阻止圣诞老人爆炸"
		Tooltip: 如果启用，圣诞老人在圣诞节结束后就不会突然消失了。
	}

	truffleKingAndQueenStatue: {
		Label: "[i:ShrimpyTruffle] 松露人是非二元性别的"
		Tooltip: 如果启用，松露人能被传送到到国王和女王雕像那里。
	}

	sellAdditionalItems: {
		Label: "[i:73] 城镇NPC出售额外物品"
		Tooltip: 如果启用，城镇NPC会出售药水、各种材料以及其他旨在减少重复性任务的物品。
	}

	persistentBuffs: {
		Label: "[i:GravitationPotion] 死亡时药水持续生效"
		Tooltip: 如果启用，当玩家死亡时，所有在保存时持续存在的增益效果（原版游戏中的药水）都将持续存在。
	}

	pannoniaeCat: {
		Label: "[npc/n:637] 潘诺尼亚的猫"
		Tooltip: 如果启用，潘诺尼亚就是一只猫。
	}

	panicKey: {
		Label: "[i:1290] 回城快捷键"
		Tooltip: 如果启用，将添加一个快捷键，允许你快速使用回忆药水。回忆药水比魔镜更好。
	}

	veinMineSpikes: {
		Label: "[i:1150] VeinMining™ 尖刺扩展"
		Tooltip:
			'''
			如果启用，著名的VeinMining™技术也能完美应对你世界中那些令人烦恼的尖刺。
			今天就试试，如果你不喜欢，就可以退款！
			'''
	}

	soyMasterMode: {
		Label: "[i:4938] 大师模式属性削弱"
		Tooltip: 如果启用，大师模式中的敌人将拥有专家模式的属性。如果你不喜欢在游戏开始时被兔子刺穿，那就太好了。
	}

	morePylons: {
		Label: "[i:4916] 更多晶塔"
		Tooltip:
			'''
			如果启用，Vanilla+ QoL 会为NPC添加一个腐化和一个猩红晶塔供其使用。
			建议启用NPC能生活在邪恶生物群落中的配置选项。
			'''
	}

	honeyImmuneHoneyLamps: {
		Label: "[i:2129] 蜂蜜灯免疫蜂蜜"
		Tooltip: 如果启用，蜂蜜灯放在蜂蜜中时不会破碎。
	}

	mineWallsFromInside: {
		Label: "[i:30] 在任何地方打破不安全墙"
		Tooltip: 如果启用的话，不安全墙不需要暴露在空气中就能被破坏。
	}

	noLavaSlime: {
		Label: "[npc/n:59] 熔岩史莱姆不掉落岩浆"
		Tooltip: 如果启用，在专家模式下，熔岩史莱姆死亡时不会掉落岩浆。
	}

	instantPlatformFallthrough: {
		Label: "[i:94] 立刻下平台"
		Tooltip: 如果启用了这个功能，你可以通过按住下键来瞬间穿过平台。
	}

	torchesOnPlatforms: {
		Label: "[i:8] 平台智能放置火把"
		Tooltip:
			'''
			1.4.4版本让平台可以放置火把，却漏掉了智能光标也该支持这一点。去死吧，Bug！
			启用后，火把也会作为智能光标的放置建议出现。
			'''
	}

	smartPlatformPlacement: {
		Label: "[i:94] 更智能的平台放置"
		Tooltip:
			'''
			启用后，智能光标会变得更聪明，为放置方向增加一定的“容错空间”，
			这样你的平台就不会一直往边缘延伸，也不会莫名其妙地被树木或高草打断。
			'''
	}

	wallsRespectPlatforms: {
		Label: "[i:93] 墙壁识别平台"
		Tooltip:
			'''
			启用后，放置墙壁时会将平台视为实体方块而非空气，
			防止智能光标在你为Boss搭建的场地中铺墙壁时越过平台边界。
			'''
	}

	blocksReplaceGrass: {
		Label: "[i:2] 智能光标无视草地"
		Tooltip:
			'''
			启用后，草地和藤蔓将不再阻挡智能光标的放置。再也不用担心搭建旧日军团场地时，
			地板上会留下空隙了……
			'''
	}

	smartCursorRange: {
		Label: "[i:407] 智能光标范围修复"
		Tooltip:
			'''
			模组添加的扩展范围饰品能增加你放置方块的距离，但智能光标却从未同步更新。
			启用此项后，这个问题就不复存在了！
			'''
	}

	coincumberingStone: {
		Label: "[i:4346] 囤钱石"
		Tooltip: 如果启用，持有负重石的玩家仍然可以拾取硬币。
	}

	coincumberingStoneRename: {
		Label: "[i:4346] 重命名囤积硬币的石头"
		Tooltip: 如果启用，负重石将被重命名为囤钱石。
	}

	killableDungeonNPCs: {
		Label: "[npc/n:72] 可击杀的地牢NPC"
		Tooltip: 如果启用，烈焰火轮和尖球可以被击杀。如果你被那些不可战胜的火焰小怪烦到了，这个功能就很有用了。
	}

	exactTooltips: {
		Label: "[i:3123] 准确的武器工具提示"
		Tooltip: 如果你喜欢破坏沉浸感的话，可以在工具提示中启用显示准确的击退值和使用时间。
	}

	damageSpread: {
		Label: "[i:1301] 伤害浮动"
		Tooltip: 在正常（默认）、仅对敌人和禁用之间切换伤害浮动。当伤害浮动被禁用时，泰拉瑞亚不会随机化所造成的伤害。
	}

	damageSpreadAmount: {
		Label: "[i:1301] 伤害浮动数值 (%)"
		Tooltip: 如果启用，设置伤害浮动的数值。默认值是15%，可以设置在0%到100%之间，这将导致伤害范围在0-2倍之间。
	}

	superCrits: {
		Label: "[i:1858] 超级暴击"
		Tooltip:
			'''
			如果启用，100%的暴击几率会产生超级暴击，造成3倍伤害，200%的暴击几率会产生4倍伤害，以此类推。
			你付出的努力不再是徒劳了。
			'''
	}

	superCritsColourValue: {
		Label: "[i:1858] 超级暴击颜色"
		Tooltip: 设置超级暴击的颜色。
	}

	superCritsColour: {
		Label: "[i:1858] 特殊颜色的超级暴击"
		Tooltip: 如果启用，超级暴击会有独特的颜色，与普通暴击区分开来。
	}

	superCritsColouredDamageTypesIntegration: {
		Label: "[i:1858] 超级暴击彩色伤害类型整合"
		Tooltip: 如果启用，Coloured Damage Types mod的集成将被启用，允许根据武器的伤害类型对超级暴击进行着色。
	}

	superCritsColouredDamageTypesDarken: {
		Label: "[i:1858] 超级暴击彩色伤害类型变暗"
		Tooltip:
			'''
			控制超级暴击相对于普通暴击的颜色深浅。
			最亮的颜色被调暗到这个值的一半，其他颜色则被调暗到这个值的全部。
			'''
	}

	removeOneDrop: {
		Label: "[i:3389] 移除 One-Drop 工具提示"
		Tooltip: 如果启用，将 One Drop 标志从基于 One Drop 生产的现实世界悠悠球中移除。
	}

	removeDevSet: {
		Label: "[i:666] 删除开发者掉落"
		Tooltip: 如果启用，宝藏袋不再掉落开发者物品了。没有乐趣，也不会让库存变得凌乱。
	}

	quickBestiary: {
		Label: "[npc/n:633] 快速解锁怪物图鉴"
		Tooltip: 如果启用，怪物图鉴中的条目在击杀一次后就会解锁，而不是通常的数量（一个旗帜）。
	}

	critsBypassDefense: {
		Label: "[i:4005] 暴击无视防御"
		Tooltip: 如果启用，暴击会忽略敌人的防御。这使得以暴击为主的装备配置在不滥用穿甲的情况下更加可行。
	}

	asphaltPlatform: {
		Label: "[i:VanillaQoL/AsphaltPlatform] 沥青平台"
		Tooltip: 如果启用，会添加一个由沥青制成的平台。通常包含在你喜欢的作弊mod中，但这次我的mod里也有。
	}

	autoResearchFavourite: {
		Label: "[i:75] 自动研究收藏物品"
		Tooltip: 如果启用，当玩家收藏的物品出现在库存中时，它们会自动被研究。 [c/FF5555:会吃掉你的物品。]
	}

	itemsWorkInBanks: {
		Label: "[i:87] 物品在个人存储中启作用"
		Tooltip: 如果启用，物品在玩家的个人存储中作为信息配件发挥作用。我们都知道你的库存里装满了药水。
	}

	itemsWorkInBanksTooltip: {
		Label: "[i:3213] 物品在个人存储中启作用的工具提示"
		Tooltip: 如果启用的话，在个人存储中作为玩家饰品的物品上会添加一个工具提示。
	}

	fountainBiomes: {
		Label: "[i:909] 喷泉改变生物群系"
		Tooltip: 如果启用，放置的喷泉会将周围区域的生物群系改为它们所使用的生物群系。这只是个小作弊，不是吗？
	}

	fountainFromInventory: {
		Label: "[i:4417] 物品栏中的喷泉会改变生物群落"
		Tooltip: 如果启用，喷泉在物品栏中持有时也会改变你周围区域的生物群落。此时，请为如此努力地作弊感到一点羞愧。
	}

	removeBiomeRequirementsShops: {
		Label: "[i:4766] 取消商店的生物群落要求"
		Tooltip:
			'''
			如果启用，NPC无论身处哪个生物群落都会出售物品。这通常会导致商店物品溢出，但这不正是我们有商店扩展的原因吗？
			需要启用商店扩展。别问我为什么，这是个诅咒。
			'''
	}

	stackableQuestItems: {
		Label: "[i:2452] 可堆叠的任务物品"
		Tooltip: 如果启用，任务物品如任务鱼可以堆叠在库存中。
	}

	axeReplantingHerbs: {
		Tooltip: ""
		Label: 斧头重新种植草药
	}

	OOAdrops: {
		Label: "[i:3817] 旧日军团的迷你boss掉落护卫奖章"
		Tooltip: 如果启用，旧日军团的迷你boss也会掉落护卫奖章，以防你无法完成整个事件。
	}

	OOAdrops2: {
		Label: "[i:3817] 旧日军团的渐进式护卫奖章掉落"
		Tooltip: 如果启用，旧日军团的前两波也会掉落护卫奖章，以防你连前两波都无法生存。
	}

	masterModeRelicsInExpert: {
		Label: "[i:4934] 专家模式可以掉落大师模式圣物"
		Tooltip: 如果启用，专家模式世界中可以掉落大师模式圣物。勇气只会被逐渐窃取。
	}

	allHairsOnStart: {
		Label: "[i:1989] 开始提供所有发型"
		Tooltip: 如果启用，所有发型从游戏开始就可用。无需找造型师解锁它们。
	}

	stackVoidBag: {
		Label: "[i:4131] 智能虚空袋"
		Tooltip: 如果启用，当拾取的物品已经存在于虚空袋中时，它们会自动堆叠到虚空袋中。
	}

	storageFollowsPlayer: {
		Label: "[i:3213] 移动存储设备跟随玩家"
		Tooltip: 如果启用，移动存储设备（钱币槽、虚空袋）会在玩家移动时跟随他们。'给你...'
	}

	npcDeathsToCallOffInvasion: {
		Label: "[i:361] 击杀NPC以取消事件"
		Tooltip: 如果设置为0以外的值，当事件期间有这么多城镇NPC死亡时，事件将提前结束。设置为0则禁用此功能。
	}

	playerDeathsToCallOffInvasion: {
		Label: "[i:1175] 玩家死亡后取消事件"
		Tooltip: 如果设置为0以外的值，当玩家在事件过程中死亡次数达到这个值时，事件将提前结束。设置为0则会禁用此功能。
	}

	moreVoidVault: {
		Label: "[i:4076] 扩展虚空保险库"
		Tooltip:
			'''
			如果启用，其他个人存储物品（猪猪存钱罐、保险箱、护卫熔炉）也可以使用虚空袋来存储物品。
			把它们弄出来有点麻烦。
			'''
	}

	grammarFix: {
		Label: "[i:389] 纠正语法"
		Tooltip:
			'''
			如果启用，物品前缀将以语法正确的方式显示在以"The"开头的物品中（例如，"The Unreal Undertaker"而不是"Unreal The Undertaker"）。
			只影响英语，因为为什么会影响其他东西呢？
			'''
	}

	siltIsDangerous: {
		Label: "[i:2329] 危险感知药水高亮泥沙块和雪泥块"
		Tooltip: 如果启用，危险感知药水会高亮泥沙块和雪泥块。不过，它们仍然会掉到你的头上。
	}

	thinIceNotDangerous: {
		Label: "[i:2329] 危险感知药水停止高亮薄冰"
		Tooltip: 如果启用，危险感知药水会停止高亮薄冰。你最终还是会掉进水里的，知道吗？
	}

	spelunkerHellstone: {
		Label: "[i:174] 洞穴探险药水高亮狱石"
		Tooltip:
			'''
			如果启用，洞穴探险药水会高亮狱石。
			你当然能在那些岩浆中看到它，但我们在这里努力营造一个包容的环境。
			'''
	}

	moreBossLoot: {
		Label: "[i:3328] 从宝藏袋中获得更多武器"
		Tooltip:
			'''
			如果启用，蜂后、世纪之花和石巨人每次从他们的宝藏袋中掉落两件武器，类似于月亮领主。
			减少磨难，增加乐趣！
			   
			'''
	}

	disableNPCHappiness: {
		Label: "[i:4986] 禁用NPC幸福度"
		Tooltip: 如果启用，将禁用NPC幸福度。出售价格因子将始终保持固定。
	}

	disableNPCHappinessConstant: {
		Label: "[i:4986] 禁用NPC幸福系数"
		Tooltip: 这控制了在NPC幸福度禁用时的售价系数。设置1.0为原价，设置为0.5可以将售价减半，等等。
	}

	boundNPCProtection: {
		Label: "[npc/n:105] 受缚NPC保护"
		Tooltip: 如果启用，受缚NPC将受到保护，不会被敌人杀死。
	}

	fixStarlightRiver: {
		Label: "[i:75] 修复星辉河陨石生成"
		Tooltip:
			'''
			启用后，修复星星光之河模组中“陨石祷文”物品失效的问题。默认情况下该物品完全无效，因为星光之河开发者写代码像AI乱生成的一样。
			此项补丁会修正 WorldGen.dropMeteor 以正确检查生成条件。
			'''
	}

	fixInfernumCrystals: {
		Label: "[i:1332] 修复炼狱模式冰柱遮挡屏幕"
		Tooltip:
			'''
			启用后，修复炼狱模式中的一个Bug——独眼巨鹿的冰柱会覆盖整个屏幕。
			这本来不是Vanilla+ QoL该修的QoL问题，但很多人都以为是，干脆就归我们管了 ;)
			'''
	}
}

