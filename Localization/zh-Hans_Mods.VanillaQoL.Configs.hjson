		Tooltip: ""
	}

	Blue: {
		Label: "[i:177] 蓝队"
		Tooltip: ""
	}

	Yellow: {
		Label: "[i:180] 黄队"
		Tooltip: ""
	}

	Pink: {
		Label: "[i:181] 粉队"
		Tooltip: ""
	}

	Tooltip: ""
