UIConfig: {
	DisplayName: Configuración de la interfaz

	enableNPCSellPrices: {
		Label: "[i:73] Activar los Precios de Venta de los NPC"
		Tooltip:
			'''
			Si está activado, mantener pulsada la tecla de favorito sobre un objeto muestra lo que cada NPC avaricioso te pagará.
			Alerta de spoiler: nunca es suficiente.
			'''
	}

	npcSellPriceYOffset: {
		Label: "[i:888] Posicionamiento Vertical"
		Tooltip: Distancia hacia abajo para apartar la visualización del precio de la cara de tonto del NPC. Los valores negativos van hacia arriba y los positivos hacia abajo. (predeterminado: 0)
	}

	npcSellPriceXOffset: {
		Label: "[i:888] Posicionamiento Horizontal"
		Tooltip: Distancia hacia la derecha para mover la visualización del precio y que no tape la decepción pixelada del NPC. (predeterminado: 40)
	}

	showPriceMultiplier: {
		Label: "[i:855] Mostrar Multiplicador de Precios"
		Tooltip: Si está activado, muestra el porcentaje de cuánto te está timando cada NPC. El rojo significa que te odian, el verde significa que simplemente les caes mal.
	}

	showCoinIcon: {
		Label: "[i:71] Mostrar Iconos de Monedas"
		Tooltip: Si está activado, muestra iconos de monedas brillantes junto a los números porque, al parecer, no podemos leer números sin dibujos bonitos.
	}

	npcSellPriceShowBackground: {
		Label: "[i:1344] Mostrar Panel de Fondo"
		Tooltip: Si está activado, añade un fondo para que puedas leer el texto de verdad en vez de entrecerrar los ojos como un abuelo.
	}

	npcSellPriceBackgroundPadding: {
		Label: "[i:1344] Relleno del Fondo"
		Tooltip: Controla lo grueso que se vuelve el fondo alrededor del texto. Números más grandes = más relleno = más fácil de leer. (predeterminado: 5)
	}

	backgroundColor: {
		Label: "[i:1344] Color de Fondo Estático"
		Tooltip: Elige un color para los fondos cuando eres demasiado aburrido para la opción dinámica.
	}

	dynamicBackgroundColor: {
		Label: "[i:1345] Color de Fondo Dinámico"
		Tooltip:
			'''
			Si está activado, el color del fondo cambia según cuánto te desprecie cada NPC.
			[c/FF0000:Rojo] para "Odio tus tripas", [c/22EE00:Verde] para "Tolero tu existencia".
			'''
	}

	npcSellPriceBackgroundColor: {
		Label: "[i:1344] Color de Fondo Manual"
		Tooltip: Para cuando quieres microgestionar el tono exacto de tu decepción en la interfaz.
	}

	fixConfigSyncCrash: {
		Label: "[i:3625] Corregir el Bloqueo de Sincronización de Mods"
		Tooltip:
			'''
			Si está activado, corrige un error de tML en el que unirse a un servidor cuyos mods tienen nuevas páginas de configuración da error y congela el juego
			 en Sincronizando mods para siempre. Un poco L.
			'''
	}

	Headers: {
		DisplayNPCSellPrices: "[i:73] Visualización de Precios de Venta de NPC"
		multiplayer: "[i:181] Multijugador"
	}
}

DamageSpread: {
	Off: {
		Label: Desactivado
		Tooltip: ""
	}

	PlayersEnemies: {
		Label: Jugadores y Enemigos (predeterminado)
		Tooltip: ""
	}

	Enemies: {
		Label: Solo Enemigos
		Tooltip: ""
	}

	Tooltip: ""
}

QoLRecipeConfig: {
	DisplayName: Configuración de Recetas
	Tooltip: Para los pollitos cuadrados

	Headers: {
		recipes: "[i:2633] Recetas"
		craftableUncraftables: "[i:36] No fabricables fabricables"
		shimmer: "[i:5350] Transmutación"
	}

	debuffImmunityRecipes: {
		Label: "[i:891] Accesorios de Inmunidad a Efectos Negativos"
		Tooltip:
			'''
			Si está activado, puedes crear el Nazar, el Bezoar, las Vitaminas, la Venda, el Mapa Tríptico, el Reloj Rápido, el Megáfono, el Espejo de Bolsillo,
			el Pulidor de Armaduras y la Venda Adhesiva en lugar de rezarle al dios del botín.
			'''
	}

	lootAccessories: {
		Label: "[i:934] Accesorios"
		Tooltip:
			'''
			Si está activado, añade recetas para accesorios que de otro modo solo se pueden encontrar: Garras d, Banda de Regeneración,
			Zapatos de púa, Caparazón de Tortuga Congelado, Carcaj Mágico, Detector de Metales y compañía.
			También permite que el Guantelete Mecánico y el Emblema Celestial utilicen cualquier emblema.
			'''
	}

	lootGear: {
		Label: "[i:724] Armas y Atuendos"
		Tooltip: Si está activado, añade recetas para el Bumerán de Hielo, el Shuriken, los Cuchillos Arrojadizos y el conjunto del Faraón.
	}

	lootTools: {
		Label: "[i:50] Herramientas y Estaciones"
		Tooltip:
			'''
			Si está activado, añade recetas para el Espejo Mágico, el Espejo de Hielo, la Red para Insectos, el Báculo de regeneración, la Máquina de Hielo,
			el Molino Celestial y la Vagoneta del Desierto.
			'''
	}

	lootKeys: {
		Label: "[i:1533] Llaves e Invocaciones"
		Tooltip:
			'''
			Si está activado, añade recetas para la Llave del Templo, la Llave de las Sombras, célula de poder de lihzahrd, el Muñeco Vudú del Guía
			y el Cristal de Gelatina.
			'''
	}

	templeTraps: {
		Label: "[i:1142] Trampas del Templo"
		Tooltip:
			'''
			 Si está activado, se añaden recetas para las trampas del Templo de la Jungla.
			'Lihzahrd...Lizhard...Lihzahrhd...'
			'''
	}

	obsidianFurniture: {
		Label: "[i:2657] Muebles de Obsidiana"
		Tooltip:
			'''
			Si está activado, añade recetas para los muebles de obsidiana generados en las casas del Inframundo.
			'Para cuando los muebles normales no son lo suficientemente oscuros'
			'''
	}

	bannerRecipes: {
		Label: "[i:846] Recetas de Estandartes del Mundo"
		Tooltip: Si está activado, añade recetas para los estandartes generados aleatoriamente en el mundo a través de varias estructuras.
	}

	teamBlocks: {
		Label: "[i:3636] Bloques de Equipo de Colores"
		Tooltip: Si está activado, añade recetas para los distintos bloques de equipo de colores y sus plataformas. '¡Jódete, Mercader Ambulante!'
	}

	clothierVoodooDoll: {
		Label: "[i:1307] Receta del Muñeco Vudú del Sastre"
		Tooltip: Si está activado, añade una receta para el Muñeco Vudú del Sastre combinando un Muñeco Vudú del Guía y un Sombrero Rojo en un altar demoníaco/carmesí.
	}

	shimmerGuns: {
		Label: "[i:4348] Armas del Modo Difícil Transmutables"
		Tooltip:
			'''
			Si está activado, el Fuego Infernal y el Zapinator naranja se pueden transmutar en la Cascada y el Zapinator gris, respectivamente.
			De lo contrario, no se pueden obtener en el Modo Difícil.
			'''
	}

	shimmerBlackLens: {
		Label: "[i:236] Lente Negra Transmutable"
		Tooltip: Si está activado, añade una transmutación en el éter para convertir una Lente Negra en una Lente normal. No estoy del todo seguro de por qué, ¡pero puede que te quedes sin lentes!
	}

	dungeonFurniture: {
		Label: "[i:139] Recetas de Muebles de la Mazmorra"
		Tooltip:
			'''
			Si está activado, añade recetas para todos los muebles de la mazmorra que normalmente tendrías que saquear.
			'Para los que tienen problemas de habilidad'
			'''
	}
}

CalamityUnnerfConfig: {
	DisplayName: Reversiones de Calamity

	Headers: {
		systems: "[i:3097] Sistemas"
		items: "[i:2218] Objetos"
		progression: "[i:1326] Progresión"
		itemStats: "[i:368] Estadísticas de Objetos"
		projectileStats: "[i:515] Estadísticas de Proyectiles"
		restored: "[i:3456] Características Restauradas"
	}

	vanillaEquipStats: {
		Label: "[i:1549] Estadísticas de Equipamiento de Armaduras Vanilla"
		Tooltip:
			'''
			Se supone que debo escribir un montón de cháchara aquí, pero esto restaura las estadísticas de las armaduras del juego base.
			Nota: estas configuraciones son un poco meh porque hay un montón de cambios de Calamity bastante insignificantes y
			exponer una opción de configuración para cada objeto nos llevaría rápidamente a 300 entradas.
			Grítame si necesitas más personalización o configuraciones específicas para objetos...
			... o si sabes una mejor forma de organizar esta basura.
			'''
	}

	projPiercing: {
		Label: "[i:515] Perforación Vanilla"
		Tooltip: Si está activado, los proyectiles atraviesan a tantos enemigos como permite el juego base, en lugar del equilibrio de Calamity.
	}

	projArmourPen: {
		Label: "[i:1302] Penetración de Armadura Vanilla"
		Tooltip: Si está activado, los proyectiles utilizan la penetración de armadura del juego base en lugar de los números de Calamity.
	}

	projSpeed: {
		Label: "[i:290] Velocidad de Proyectiles Vanilla"
		Tooltip: Si está activado, utiliza las velocidades de los proyectiles del juego base en lugar de las de Calamity.
	}

	projLifetime: {
		Label: "[i:1321] Duración de Proyectiles Vanilla"
		Tooltip: Si está activado, los proyectiles utilizan la duración del juego base.
	}

	projScale: {
		Label: "[i:1444] Tamaño de Proyectiles Vanilla"
		Tooltip: Si está activado, los proyectiles utilizan el tamaño de proyectil del juego base.
	}

	projYoyoStats: {
		Label: "[i:3286] Estadísticas de Yo-yos Vanilla"
		Tooltip:
			'''
			Calamity reequilibra el alcance, la velocidad máxima y la duración de cada yo-yo del juego base.
			Si está activado, todos vuelven a los valores de vanilla.
			'''
	}

	projCollision: {
		Label: "[i:497] Comportamiento de Agua y Bloques Vanilla"
		Tooltip: Si está activado, los proyectiles ignoran el agua y chocan con los bloques exactamente como lo hacía el juego base en lugar de usar los valores de Calamity.
	}

	projTrueMelee: {
		Label: "[i:273] Clases de Daño Vanilla"
		Tooltip: Si está activado, elimina las clases de daño de Calamity como el cuerpo a cuerpo verdadero. Para ser sincero, no sé por qué necesitarías esto. Quizás no lo hagas.
	}

	itemDamage: {
		Label: "[i:368] Daño de Objetos Vanilla"
		Tooltip:
			'''
			Calamity reequilibra el daño de un par de cientos de armas del juego base. Si está activado, cada una de ellas vuelve
			al número de vanilla. Esto es una combinación de mejoras y debilitamientos.
			'''
	}

	itemCrit: {
		Label: "[i:1248] Probabilidad de Crítico de Objetos Vanilla"
		Tooltip: Si está activado, la probabilidad de crítico de cada objeto vuelve a la del juego base en lugar de usar los valores de Calamity.
	}

	itemDefence: {
		Label: "[i:1316] Defensa de Armaduras Vanilla"
		Tooltip: Si está activado, las piezas de armadura recuperan su defensa del juego base.
	}

	itemMana: {
		Label: "[i:1595] Costos de Maná Vanilla"
		Tooltip: Si está activado, las armas mágicas cuestan lo que el juego base dice que cuestan en lugar de lo que Calamity cree que deberían costar.
	}

	itemSpeed: {
		Label: "[i:211] Velocidad de Ataque Vanilla"
		Tooltip:
			'''
			Si está activado, todo vuelve a atacar a la velocidad del juego base.
			'Mi filete es demasiado jugoso y mi langosta tiene demasiada mantequilla'
			'''
	}

	itemShootSpeed: {
		Label: "[i:97] Velocidad de Proyectiles de Objetos Vanilla"
		Tooltip: Si está activado, las armas disparan sus proyectiles a la velocidad que el juego base pretendía en lugar de la de Calamity.
	}

	itemKnockback: {
		Label: "[i:897] Retroceso Vanilla"
		Tooltip: Si está activado, las armas del juego base obtienen su retroceso original en lugar del de Calamity.
	}

	itemScale: {
		Label: "[i:536] Tamaño de Hitbox Vanilla"
		Tooltip: Si está activado, las armas cuerpo a cuerpo vuelven a su tamaño del juego base. (principalmente más pequeñas)
	}

	itemValue: {
		Label: "[i:855] Precios de Venta Vanilla"
		Tooltip:
			'''
			Calamity declara que un montón de objetos del juego base no valen nada y cambia los precios de muchos otros.
			Si está activado, restaura el equilibrio del juego base.
			'''
	}

	itemToolPower: {
		Label: "[i:122] Estadísticas de Herramientas Vanilla"
		Tooltip: Si está activado, las estadísticas de los picos, hachas y martillos vuelven a las del juego base en lugar de las de Calamity.
	}

	itemBehaviour: {
		Label: "[i:407] Comportamiento de Objetos Vanilla"
		Tooltip:
			'''
			Si está activado, los tamaños de las pilas y un montón de tonterías variadas también vuelven a los valores del juego base.
			Si lees esto, regañame por esta configuración de baja categoría.
			'''
	}

	vanillaRecipes: {
		Label: "[i:4457] Recetas de Vanilla Desactivadas"
		Tooltip: Calamity elimina las recetas del juego base para la Mini Nuclear I, la Mini Nuclear II y el catalejo táctico. Ya no más.
	}

	astralDrops: {
		Label: "[i:3460] Probabilidades de Drop de Enemigos del Astral"
		Tooltip:
			'''
			A los enemigos de la Infección Astral se les redujo la probabilidad de soltar armas de 1 en 7 a 1 en 10.
			Si está activado, vuelve a ser de 1 en 7.
			'''
	}

	crateLoot: {
		Label: "[i:2334] Botín de Cajas de Calamity"
		Tooltip:
			'''
			Si está activado, restaura el buen botín de pesca de antaño de Calamity. Calamity quiere fomentar la pesca eliminando el kit de pesca,
			pero luego nerfea la pesca porque la pesca se volvió demasiado divertida.
			'Anti-Anti-Diversión'
			'''
	}

	shopStock: {
		Label: "[i:1326] Inventario de la Tienda de NPCs de la Ciudad"
		Tooltip:
			'''
			Si está activado, vuelve a añadir 23 objetos a las tiendas de los NPCs, por ejemplo, la Varita de la discordia, armas mágicas, las armas del Traficante de Armas,
			el lanzacohetes y un montón de comida.
			'Calamity elimina la QoL más rápido de lo que puedo volver a añadirla'
			'''
	}

	anglingKits: {
		Label: "[i:3120] Kits de Pesca"
		Tooltip:
			'''
			El Azote del Desierto y el Azote Acuático solían soltar una bolsa de aparejos de pesca cada uno, lo cual es la cúspide de la ironía viniendo de un gusano del desierto. Calamity eliminó ambos porque se supone que debes ir a pescar en su lugar. Luego borró rápidamente todas las buenas cajas también. lol, lmao incluso.
			Si está activado, se vuelven a añadir.
			'''
	}

	earlyCosmolight: {
		Label: "[i:3456] Cosmoluz Temprana"
		Tooltip:
			'''
			La Cosmoluz solía ser una creación de principios del modo difícil a partir de almas. Ahora requiere un Bakidon y
			lingotes astrales, lo que la bloquea tras Astrum Deus, como a dos tercios de todo el mod.
			Si está activado, esto restaura la receta antigua.
			'''
	}

	starterBag: {
		Label: "[i:166] Extras de la Bolsa Inicial"
		Tooltip:
			'''
			La bolsa inicial solía venir con 10 bombas, 3 cofres y un montón de pociones además de las armas aleatorias de clase.
			Si está activado, los extras vuelven.
			'''
	}

	expertDrops: {
		Label: "[i:3224] Accesorios de Experto en Normal"
		Tooltip:
			'''
			Si está activado, hace que los jefes también suelten los accesorios exclusivos de Experto en modo Normal.
			Calamity eliminó esto, como era de esperar.
			'''
	}

	autoswing: {
		Label: "[i:29] Ataque automático"
		Tooltip:
			'''
			Calamity añadió ataque automático a 150 objetos del juego base, y luego eliminó esta característica bajo el argumento
			de que la versión 1.4.4 tiene una opción para ello. Excepto que no cubre el Cristal de vida, la Fruta de la vida, el Cristal de maná o los aviones de papel.
			Si está activado, se restaura la característica de ataque automático.
			'''
	}

	defenceBonuses: {
		Label: "[i:156] Defensa de Escudos y Armaduras"
		Tooltip:
			'''
			Calamity solía dar un poco de defensa a varios accesorios para que tuvieran utilidad.
			Por ejemplo, la línea del Escudo Ankh recibía +4, el Caparazón de tortuga congelada recibía 6, etc.
			Si está activado, se restauran las mejoras.
			'''
	}

	manaDiscounts: {
		Label: "[i:3269] Costos de Maná de Armas Mágicas"
		Tooltip:
			'''
			Quince armas mágicas del juego base solían costar menos maná de lo que cobra el juego base. Calamity "revirtió casi todas
			las modificaciones de costo de maná", lo que es una forma elegante de decir que cada descuento ha desaparecido porque jódete, por eso.
			Si está activado, restaura los descuentos.
			'Cara gano yo, cruz pierdes tú'
			'''
	}

	wingBonuses: {
		Label: "[i:492] Bonificaciones de Estadísticas de Alas"
		Tooltip:
			'''
			Debería escribir un montón de cosas aquí sobre cómo arruinaron las alas, pero probablemente ya lo sepas.
			Si está activado, recuperan su inocencia.
			'''
	}

	fireImmunity: {
		Label: "[i:193] Inmunidad a ¡En llamas!"
		Tooltip:
			'''
			La línea de la Calavera de Obsidiana, el Escudo Ankh y las Botas de Terrachispa solían hacerte inmune a ¡En llamas!,
			lo cual es la única razón por la que alguien se pone una Calavera de Obsidiana.
			Parece que se cargaron al "paciente cero de la inmunidad al fuego".
			Si está activado, este cambio se revierte.
			'''
	}

	summonSpeed: {
		Label: "[i:1157] Invocadores de Eventos No Consumibles y Velocidad de Invocación"
		Tooltip:
			'''
			Todas las varitas de invocación y bastones de centinela del juego base eran más rápidos en la versión antigua de Calamity, y los invocadores de eventos no se consumían.
			Seguro que le ves el patrón.
			Si está habilitada, se revierten estos dos cambios.
			'''
	}

	toolPower: {
		Label: "[i:2176] Poder y Velocidad de las Herramientas"
		Tooltip:
			'''
			Todo el reequilibrio de herramientas de Calamity "desapareció" misteriosamente. Ahora los taladros son claramente peores que los picos y...
			Ni voy a ponerme a escribir todo eso.
			Si está habilitada, vuelven los valores de la 2.0.4. Bastante guapo.
			'''
	}

	armourBonuses: {
		Label: "[i:1006] Bonificaciones de Armaduras de Minerales del Modo Difícil"
		Tooltip:
			'''
			La actualización de Calamity se cargó todas las bonificaciones de conjuntos de armaduras de mineral graciosas y solo *ligeramente* rotas.
			Si está habilitada, los revierte a los valores antiguos.
			'Más que salvaje, manso'
			'''
	}

	prefixScaling: {
		Label: "[i:1615] Progresión de Prefijos de Defensa"
		Tooltip:
			'''
			La respuesta de la versión antigua de Calamity a "¿por qué iba a reforjar para conseguir defensa al final del juego?" era hacer que Duro, Protector,
			Blindado y Guardián crecieran con la progresión. Como era de esperar, esto se eliminó porque, ¿para qué molestarse con la defensa de todos modos?
			Si está habilitada, se restaura esta característica.
			'''
	}

	sicknessContactDamage: {
		Label: "[i:1329] Menos Daño por Contacto de Enemigos Enfermos"
		Tooltip:
			'''
			Los enemigos con las desventajas de Envenenado, Veneno, Infección Astral y Plaga solían infligir un 5% menos de daño por contacto.
			Ahora solo lo hace Muerte Susurrante.
			Si está habilitada, los otros cuatro vuelven a tener la penalización del 5%.
			'''
	}

	nurseAndTaxes: {
		Label: "[npc/n:18] Enfermera e Impuestos"
		Tooltip:
			'''
			La Enfermera pasó de cobrar una tarifa fija por visita a multiplicar por unas 600 veces, como mucho, el precio por PV del juego base.
			Las tarifas del Recaudador de Impuestos se redujeron en la otra dirección; ahora paga de la mitad a la cuarta parte.
			Si está habilitada, se revierten estos cambios, ella no te curará en absoluto en los modos Muerte o Boss Rush, y el Recaudador de Impuestos volverá a pagar 1 plata y 50 cobre por NPC.
			'Lo único seguro en esta vida son la Enfermera y los Impuestos'
			'''
	}

	spawnRates: {
		Label: "[i:288] Modificadores de la Tasa de Aparición"
		Tooltip:
			'''
			Calamity solía reequilibrar las tasas de las pociones de aparición. Esto se eliminó y no se me ocurre ninguna razón concebible del porqué.
			Si está habilitada, los valores antiguos vuelven a estar vigentes.
			'''
	}

	sellPrices: {
		Label: "[i:74] Precios de Venta de Calamity"
		Tooltip:
			'''
			Calamity solía tener mejores precios de venta para su equipamiento debido a lo absurdamente rotos que estaban los objetos. Esto ha sido destrozado por completo.
			Si está habilitada, ya no.
			'''
	}

	shieldImmunities: {
		Label: "[i:1613] Inmunidades a Desventajas de los Escudos"
		Tooltip:
			'''
			El Valor de Asgard solía fabricarse a partir de un Escudo Ankh e integraba sus inmunidades a desventajas.
			Toda la línea del Escudo Ornamentado también ha perdido todas las inmunidades que tenía, y la receta ya no requiere un Escudo Ankh, así que disfruta usando dos espacios para accesorios, supongo.
			Si está habilitada, se vuelven a añadir las inmunidades y el caminar sobre bloques de fuego, y el Valor de Asgard vuelve a requerir un Escudo Ankh.
			'Si lo quitas todo, ¿qué queda?'
			'''
	}

	soaringInsignia: {
		Label: "[i:4989] Reversión del Nerfeo de la Insignia Deslumbrante"
		Tooltip: Si está habilitada, deshace los nerfeos de Calamity a la aceleración al correr de la Insignia Deslumbrante y restaura el vuelo infinito.
	}

	meteorArmour: {
		Label: "[i:123] Reversión del Nerfeo de la Armadura de Meteorito"
		Tooltip:
			'''
			Calamity cambia el bonus de conjunto de la armadura de meteorito: pierdes el maná gratis para la Pistola Espacial y obtienes un 33% de coste de maná en
			cada pistola mágica en su lugar. No es realmente un nerfeo per se, pero tampoco es el efecto gracioso, así que aquí tienes una reversión ;)
			'''
	}

	blackBelt: {
		Label: "[i:963] Reversión del Nerfeo del Cinturón Negro"
		Tooltip:
			'''
			Si está habilitada, deshace el tiempo de reutilización compartido de 90 segundos de Calamity para el Cinturón Negro.
			'Esquivas para el Dios de las Esquivas'
			'''
	}

	brainOfConfusion: {
		Label: "[i:3223] Reversión del Nerfeo del Cerebro de la Confusión"
		Tooltip:
			'''
			Si está habilitada, deshace el tiempo de reutilización compartido de 90 segundos de Calamity para el Cerebro de la Confusión.
			'Esquivas para el Dios de las Esquivas'
			'''
	}

	shadowArmour: {
		Label: "[i:86] Reversión del Nerfeo de la Armadura de las Sombras"
		Tooltip:
			'''
			Si está habilitada, deshace los nerfeos de Calamity a la armadura de las sombras. Reduce su aumento de movimiento y además decide que no debería acumularse
			con la Magiluminiscencia.
			'''
	}

	damageReduction: {
		Label: "[i:3224] Reversión del Nerfeo de la Reducción de Daño"
		Tooltip:
			'''
			Calamity pasa silenciosamente toda tu reducción de daño por una fórmula, de modo que el 25% es el nuevo 20%, el 50% es el nuevo 33%,
			y el 100% es el nuevo 50%. Si está habilitada, arreglamos esto.
			'''
	}

	bossDR: {
		Label: "[i:3097] Reversión del Nerfeo de la RD de Jefes Vanilla"
		Tooltip:
			'''
			Calamity otorga a 22 jefes de vanilla reducción de daño fija, presumiblemente para evitar matar a los jefes demasiado rápido.
			Esto es un poco cutre, así que si esta opción está habilitada, A LA MIERDA.
			Echo de menos a ese chico que escribía los mensajes graciosos de configuración :(
			'''
	}

	calamityBossDR: {
		Label: "[i:3097] Reversión del Nerfeo de la RD de Jefes de Calamity"
		Tooltip:
			'''
			Si está habilitada, la misma reducción de daño fija se desactiva también para los jefes de Calamity.
			Para ser justos, algunos jefes se podrán superar de forma trivial si haces esto.
			'''
	}

	pierceResist: {
		Label: "[i:3029] Reversión del Nerfeo de Proyectiles Perforantes"
		Tooltip:
			'''
			El Devorador de Mundos, los Creepers del BoC y El Destructor pierden un 12% de daño por cada golpe de un proyectil
			perforante, limitado a un -80%. Si está habilitada, esta mecánica se elimina.
			'''
	}

	lifesteal: {
		Label: "[i:1569] Reversión del Nerfeo de Recuperación de Robo de Vida"
		Tooltip:
			'''
			Terraria tiene un medidor oculto de robo de vida que se recarga a 36 PV/s en Clásico y 30 en Experto.
			Calamity lo hace mucho menos efectivo, reduciéndolo a 9 y 6 PV/s respectivamente, y también hace que no puedas curarte por robo de vida si tienes más del 50% de tu salud máxima.
			Si está habilitada, esto deshace ese nerfeo.
			Aviso: la wiki también os está mintiendo, dice que ya no nerfea el robo de vida hasta el suelo. ¡Esto ha sido VERIFICADO ahora :P
			'''
	}

	meleeArmourDR: {
		Label: "[i:2218] Reversión del Nerfeo de la RD de Armadura de Escarabajo y Bengala Solar"
		Tooltip: Si está habilitada, la Armadura de Escarabajo y la Armadura de Bengala Solar recuperan su reducción de daño multiplicativa de vanilla en lugar de una cantidad fija.
	}

	buffs: {
		Label: "[i:353] Reversión del Nerfeo de Mejoras Permanentes"
		Tooltip:
			'''
			Si está habilitada, elimina los cambios de Calamity a un montón de efectos de estado:
			Bien alimentado otorga un 20% de velocidad en lugar de un 5%, Poder mágico otorga un 20% en lugar de un 10%,
			Arquería otorga un 10% de daño en lugar de un 5%, Clarividencia otorga un 5% de daño mágico en lugar de un 3%,
			Rapidez otorga un 25% de velocidad en lugar de un 15%, Minería otorga un 25% de velocidad de minería en lugar de un 15%,
			y Subidón de azúcar otorga un 20% de velocidad y un 20% de minería en lugar de un 10% cada uno.
			Borracho es el gracioso porque Calamity lo deja sin daño cuerpo a cuerpo, sin crítico y con un 10% *peor* de velocidad cuerpo a cuerpo,
			donde vanilla te cambia 4 de defensa por +10% de daño cuerpo a cuerpo, +2 de crítico y +10% de velocidad cuerpo a cuerpo.
			Por cierto, las descripciones también están arregladas
			'''
	}

	damageVariance: {
		Label: "[i:3119] Reversión del Nerfeo de la Varianza de Daño"
		Tooltip:
			'''
			Si está habilitada, restaura las mecánicas de varianza de daño de vanilla. Calamity la redujo mucho y le quitó la suerte por completo.
			'¡Los e-sports no significan un enfrentamiento simétrico sin RNG!'
			'''
	}

	multiplayerBossHealth: {
		Label: "[i:29] Reversión del Bufado de Salud de Jefes en Multijugador"
		Tooltip: Si está habilitada, revierte el aumento de Calamity a la salud de los jefes en multijugador. ¿Quizás tanquear no es divertido?
	}

	meleeResist: {
		Label: "[i:273] Reversión del Nerfeo de la Resistencia Cuerpo a Cuerpo"
		Tooltip:
			'''
			Las armas cuerpo a cuerpo hacen un 25% menos de daño al Devorador de Mundos y a los Creepers del Cerebro, y la mitad al Destructor.
			Si está habilitada, esto se revierte porque esto es literalmente un bufo de vida de jefes para cobardes.
			'''
	}

	ichorDefence: {
		Label: "[i:1332] Reversión del Nerfeo del Ícor"
		Tooltip:
			'''
			El Ícor de vanilla reduce la defensa enemiga en 15 puntos. Calamity lo nerfea silenciosamente a 10, pero la descripción sigue diciendo 15.
			Si está habilitada, el Ícor vuelve a hacer lo que dice que hace.
			'''
	}

	hallowedDodge: {
		Label: "[i:553] Reversión del Nerfeo de la Esquiva Sagrada"
		Tooltip:
			'''
			A la esquiva de la armadura sagrada se le añade un tiempo de reutilización de 30 segundos mediante el sistema de tiempos de reutilización de Calamity.
			Si está habilitada, este cambio se revierte.
			'''
	}

	wingAscent: {
		Label: "[i:749] Reversión del Nerfeo de Velocidad de Ascenso de Alas"
		Tooltip:
			'''
			Las velocidades de ascenso de las alas de mariposa y fantasma fueron nerfeadas a cambio de una mejor aceleración.
			Si está habilitada, este cambio se revierte. (Esto no es un nerfeo estricto, más bien un reajuste, por lo que no está activado por defecto)
			'''
	}

	shieldBonkSafety: {
		Label: "[i:3097] Reversión del Choque del Escudo de Cthulhu"
		Tooltip:
			'''
			Mientras usas la embestida del Escudo de Cthulhu, se supone que estás a salvo de recibir daño al chocar.
			Hasta que llega Calamity y elimina la inmunidad en los últimos cuatro fotogramas, así que disfruta del daño, supongo.
			Si está habilitada, toda la embestida vuelve a otorgar inmunidad.
			'''
	}

	shimmerGating: {
		Label: "[i:1326] Reversión del Procesamiento del Brillo"
		Tooltip: Si está habilitada, el Brillo deja de comprobar tu registro de jefes. El título.
	}

	bloodMoonRequirement: {
		Label: "[i:4271] Reversión de los Requisitos de la Luna de Sangre"
		Tooltip: Calamity aumenta mucho los requisitos de la Luna de Sangre. Si está habilitada, este cambio se revierte.
	}

	fossilShattering: {
		Label: "[i:3380] Reversión de la Fragmentación de Fósiles"
		Tooltip:
			'''
			El fósil del desierto se rompe en fósiles resistentes cuando cae desde suficiente altura. Calamity elimina esto.
			Si está habilitada, los fósiles vuelven a romperse.
			'''
	}

	classConversions: {
		Label: "[i:3806] Reversión de la Conversión de Clases"
		Tooltip:
			'''
			El conjunto del monje de nivel 2 y 3 y el de Asesino de cristal se convierten en armadura de pícaro. Si está habilitada, esto se revierte.
			Desactivado por defecto, porque es un reajuste en lugar de un nerfeo y alguien por ahí está a mitad de una partida
			de pícaro. ;)
			'''
	}

	summonerCrossClass: {
		Label: "[i:1157] Reversión del Nerfeo Multiclase de Invocador"
		Tooltip:
			'''
			Si sostienes cualquier cosa que no sea un arma de invocador, recibes un nerfeo del 25% de daño a tus súbditos.
			Los propios súbditos de Calamity están exentos de esto, por lo que en la práctica es un impuesto por usar invocaciones de vanilla.
			Si está habilitada, esta mecánica absurda se revierte.
			'''
	}

	balloonJump: {
		Label: "[i:159] Reversión del Nerfeo del Salto de Globo"
		Tooltip:
			'''
			Se supone que los globos aumentan la altura y la velocidad de tus saltos. Calamity elimina la
			parte de la altura por completo y reduce la velocidad a un mísero +0,75.
			Si está habilitada, se restauran los valores de vanilla.
			'''
	}

	beetleMight: {
		Label: "[i:2200] Reversión del Nerfeo de Poder de Escarabajo"
		Tooltip:
			'''
			La Cota de Escamas de Escarabajo otorga un 10% de daño cuerpo a cuerpo y un 10% de velocidad cuerpo a cuerpo por cada escarabajo en vanilla.
			Calamity reduce silenciosamente la velocidad a la mitad 5%, lo cual es genial para un conjunto cuyo único propósito es el cuerpo a cuerpo.
			Si está habilitada, se vuelve a restaurar el 10% de vanilla.
			'''
	}

	scopes: {
		Label: "[i:1858] Reversión del Nerfeo de Mira"
		Tooltip: Si está habilitada, restaura los valores de la Mira de Francotirador y la Mira de Reconocimiento.
	}

	spectreAndVampire: {
		Label: "[i:1446] Reversión del Reajuste de Curación de Espectro y Vampiro"
		Tooltip:
			'''
			Si está habilitada, desactiva los reajustes de Calamity a las mejoras de curación de Espectro y de los Vampiros.
			No está activada por defecto por razones obvias.
			'''
	}

	asphaltAndSkates: {
		Label: "[i:775] Reversión del Nerfeo de Asfalto y Patines de Hielo"
		Tooltip: Si está habilitada, restaura los valores de velocidad y aceleración de vanilla para el Asfalto y los Patines de Hielo.
	}

	nebulaArmour: {
		Label: "[i:2760] Reversión de la Reversión de la Armadura Nebulosa"
		Tooltip:
			'''
			Si está habilitada, elimina la reversión de la armadura nebulosa de Calamity.
			A estas alturas ya ni tengo una descripción ingeniosa para esto.
			'''
	}

	meleeSpeedStacking: {
		Label: "[i:1343] Reversión del Nerfeo de Acumulación de Velocidad Cuerpo a Cuerpo"
		Tooltip:
			'''
			Las Garras de Bestia, los tres guantes, el Guantelete de fuego, la Piedra Solar y Lunar y la Piedra/Caparazón Celestial ya no se acumulan.
			Si está habilitada, vuelven a acumularse como se supone que deben hacerlo en vanilla.
			'''
	}

	whipTagCrits: {
		Label: "[i:4679] Reversión del Nerfeo de Críticos por Marca de Látigo"
		Tooltip:
			'''
			Si se elimina, restaura la marca de invocación de los látigos para la Estrella Matutina y el Caleidoscopio.
			Supongo que algunos de los desarrolladores de Calamity odian estos látigos a pesar de ¡no haber añadido ninguno!
			'''
	}

	terrarianProjectiles: {
		Label: "[i:3389] Reversión del Nerfeo del Terrarian"
		Tooltip:
			'''
			El truco del Terrarian es lanzar una cantidad obscena de yoyós. Calamity limita cuántos pueden existir, lo cual
			es un poco como nerfear la Cénit por tener demasiadas espadas (ah, espera, ¡si ya le pusieron un bloqueo de nivel de todos modos...)
			Si está habilitada, este cambio se elimina.
			'''
	}

	immunityFrames: {
		Label: "[i:554] Si está habilitada, este cambio se elimina."
		Tooltip:
			'''
			Si está habilitada, elimina los cambios de Calamity en los fotogramas de inmunidad de unos cientos de proyectiles de vanilla.
			Evita la acumulación de proyectiles trasladándolos a un tiempo de reutilización compartido.
			'''
	}

	jungleArmour: {
		Label: "[i:228] Reversión del Nerfeo de la Armadura de la Jungla"
		Tooltip: Si está habilitada, revierte el nerfeo de Calamity a la armadura de la jungla para dejarla con sus estadísticas de vanilla.
	}

	frostArmour: {
		Label: "[i:684] Reversión de la Armadura de Escarcha"
		Tooltip: Si está habilitada, restaura las estadísticas de vainilla de la armadura de escarcha. Para ser justos, es más un reajuste que un nerfeo.
	}

	yoyoGlove: {
		Label: "[i:3334] Reversión del Nerfeo del Guante de Yoyó"
		Tooltip:
			'''
			Si está habilitada, revierte el nerfeo del 50% de Calamity al daño de los yoyós secundarios otorgados por el Guante de Yoyó.
			'Un contrapeso contra la policía de la diversión'
			'''
	}

	defenseDamage: {
		Label: "[i:156] Eliminar Daño a la Defensa"
		Tooltip:
			'''
			Si está habilitada, desactiva la mecánica de daño a la defensa de Calamity que desincentiva recibir golpes de frente.
			El único problema es que recibir golpes de los jefes de frente es divertido y esto no es Touhou.
			Nota: esto hace que el Núcleo de Sangrelunar sea inútil, te lo advierto ;)
			'''
	}
}

CalamityQoLConfig: {
	DisplayName: Calamity QoL

	Headers: {
		gameplay: "[i:3515] Jugabilidad"
		playerBoosts: "[i:54] Mejoras de Jugador"
		recipes: "[i:36] Recetas"
	}

	fullExpertRegen: {
		Label: "[i:1787] Regeneración sin Aperitivo"
		Tooltip:
			'''
			Si está habilitada, el modo Experto deja de reducir a la mitad tu regeneración de vida cuando no estás bien alimentado.
			Por cierto, el juego nunca te dijo que estaba haciendo eso, el pico de los juegos basados en la wiki.
			'''
	}

	starterBag: {
		Label: "[i:1774] Bolsa de Inicio"
		Tooltip:
			'''
			Si está habilitada, los nuevos personajes reciben una bolsa que contiene exactamente el kit que estabas a punto de tardar diez minutos en crear.
			Haz clic derecho para abrir. Contiene cuerda, así que por favor no hagáis speedruns de pesca (FSH) ni de plataformas (PSH).
			'''
	}

	fasterMovement: {
		Label: "[i:212] Movimiento Base Más Rápido"
		Tooltip:
			'''
			Si está habilitada, te mueves un 50% más rápido sin las Botas de Hermes para aquellos a los que odian el principio del juego.
			Se desactiva automáticamente si Terraria Overhaul está cargado, ya que este modifica el movimiento de todos modos.
			'''
	}

	higherJumpHeight: {
		Label: "[i:2423] Saltos Más Altos"
		Tooltip: Si está habilitada, la altura de tu salto base pasa de 5,01 a 5,51, lo que te permite subir aproximadamente un bloque más en la práctica.
	}

	fasterJumpSpeed: {
		Label: "[i:159] Saltos Más Rápidos"
		Tooltip: Si está habilitada, saltas un 4% más rápido (o un 24% más rápido mientras llevas alas).
	}

	fasterTilePlacement: {
		Label: "[i:2214] Construcción Más Rápida"
		Tooltip: Si está habilitada, colocas bloques y paredes mucho más rápido.
	}

	fasterFall: {
		Label: "[i:716] Mantener Abajo para Caer Más Rápido"
		Tooltip: Si está habilitada, mantener presionado Abajo en el aire duplica tu gravedad (tu velocidad máxima de caída no cambia).
	}

	vanillaRecipeTweaks: {
		Label: "[i:1006] Recetas de Vanilla Más Baratas"
		Tooltip:
			'''
			Si está habilitada, un montón de recetas de vanilla dejan de tomarte el pelo.
			- Las flechas de bufón y las pociones de teletransportación se ceban en lotes.
			- Las barras de clorofita y champiñonita requieren menos mineral.
			- El Verdadero Borde de la Noche pide 3 almas mecánicas de cada tipo en lugar de 20.
			- Las cosas del inicio del modo difícil no requieren el yunque de mithril.
			- También coloca el arma antes que las barras en las recetas de piedra infernal y de escarabajo, porque al revés es objetivamente incorrecto.
			'''
	}

	evilBiomeSwaps: {
		Label: "[i:3224] Intercambiar Objetos de la Corrupción y el Carmesí"
		Tooltip:
			'''
			Si está habilitada, puedes intercambiar cualquier objeto exclusivo de la Corrupción por su equivalente del Carmesí y viceversa en un cementerio.
			Por ejemplo: bufanda de gusano por cerebro de la confusión, mosquete por sepulturero, etc.
			'No me decido entre la Corrupción o el Carmesí'
			'''
	}

	earlyWeaponRecipes: {
		Label: "[i:65] Recetas de Armas Iniciales"
		Tooltip:
			'''
			Si está habilitada, añade recetas para armas iniciales que de otro modo son pura lotería, como la espada encantada, la furia estelar,
			el rayo de agua, el báculo de slime, el Bastón de Finch, etc.
			'''
	}

	accessoryRecipes: {
		Label: "[i:54] Recetas de Accesorios"
		Tooltip:
			'''
			Si está habilitada, añade recetas para los accesorios que se supone que debes encontrar bajo tierra.
			(Botas de Hermes, nube en botella, herradura de la suerte, amuleto de lava, rosa de obsidiana, etc.)
			'Tiene gracia las primeras 50 veces'
			'''
	}

	armourRecipes: {
		Label: "[i:804] Recetas de Armaduras"
		Tooltip: Si está habilitada, añade recetas para el conjunto de esquimal.
	}

	summonRecipes: {
		Label: "[i:43] Recetas de Invocación"
		Tooltip: Si está habilitada, añade recetas para la lágrima sangrienta y el globo de nieve.
	}

	miscRecipes: {
		Label: "[i:4346] Recetas Variadas"
		Tooltip:
			'''
			Si está habilitada, añade recetas para la Piedra agobiante, la Estatua de líber, el cristal de vida, la concha mágica, el paraguas
			y todas las lápidas del juego. Mira mamá, alguien quería las lápidas.

			'El peso de escribir descripciones ingeniosas'
			'''
	}

	shimmerRecipes: {
		Label: "[i:5364] Transmutaciones Adicionales de Éter"
		Tooltip: Si está habilitada, los tres accesorios de información se pueden transformar el uno en el otro, al igual que la espada encantada y la Terragrim.
	}
}
