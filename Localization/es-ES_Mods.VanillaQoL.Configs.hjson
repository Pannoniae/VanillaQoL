QoLConfig: {
	DisplayName: Configuración de QoL

	townNPCsSpawningAtNight: {
		Label: "[i:4951] Permitir que los NPC de la ciudad aparezcan de noche"
		Tooltip: Si está habilitado, los NPC de la ciudad también pueden aparecer por la noche.
	}

	townNPCsMovingAtDay: {
		Label: "[i:4951] Permitir que los NPC de la ciudad se teletransporten de día"
		Tooltip: Si está habilitado, los NPC de la ciudad pueden teletransportarse a sus casas durante el día.
	}

	betterCensus: {
		Label: "[i:25] Lista de NPC de la ciudad"
		Tooltip:
			'''
			Si está habilitado, muestra en el menú de viviendas todos los NPC de la ciudad que aún no se han mudado, junto con lo que están esperando.
			Un tic verde significa que está listo para mudarse. Una X roja: aún no. Una interrogación morada: desconocido.
			'''
	}

	npcHappinessOnHover: {
		Label: "[i:58] Felicidad de los NPC al pasar el cursor"
		Tooltip:
			'''
			Si está habilitado, puedes pasar el cursor sobre un NPC alojado en el menú de viviendas para ver sus precios y a quién y qué aman, les gusta o detestan.
			No más interrogar a cada aldeano a través de tres menús como si fueras un inspector de Hacienda.
			'''
	}

	censusSpoofing: {
		Label: "[i:267] Temu Census"
		Tooltip: Si está habilitado, ofrece compatibilidad con otros mods y sus Mod.Calls fingiendo ser Census.
	}

	npcLocatingArrow: {
		Label: "[i:393] Geocaché de NPC"
		Tooltip: Si está habilitado, puedes pasar el cursor sobre un NPC alojado en el menú de viviendas y aparecerá una flecha que apuntará hacia donde se encuentre.
	}

	npcArrowColour: {
		Label: "[i:1071] Color de la flecha de geocaché de NPC"
		Tooltip: ¡Píntalo de negro!
	}

	censusSpoilerMode: {
		Label: "[i:1307] NPC de Census sin spoiler"
		Tooltip:
			'''
			Si está habilitado, oculta las condiciones de aparición en las descripciones de la lista para que solo veas quién falta, no cómo invocarlos.
			'Terraria: Edición Anti-Wiki'
			'''
	}

	townPetsInvincible: {
		Label: "[i:4829] Las mascotas y slimes de la ciudad son invencibles"
		Tooltip: Si está habilitado, los adorables animales de la ciudad y los slimes no sufrirán daño por parte de enemigos o jefes.
	}

	Headers: {
		information: "[i:3095] Información"
		gameplay: "[i:3515] Jugabilidad"
		fixes: "[i:3625] Correcciones"
		content: "[i:757] Contenido"
		craftableUncraftables: "[i:36] No fabricables fabricables"
		respawn: "[i:708] Reaparición"
		suffering: "[npc/n:369] Sufrimiento"
		multiplayer: "[i:181] Multijugador"
		holidayCheer: "[i:602] Espíritu Festivo"
		cheats: "[i:3999] Trucos"
		testing: "[i:2] Pruebas"
		tweaks: "[i:1344] Ajustes"
		combat: "[i:757] Combate"
		recipes: Cabecera de recetas
		npcs: "[npc/n:178] NPCs"
	}

	showHookTooltips: {
		Label: "[i:185] Mostrar Información de los Ganchos"
		Tooltip: Si está habilitado, los ganchos muestran su alcance de agarre y cuántos ganchos pueden disparar simultáneamente en su descripción.
	}

	showWingTooltips: {
		Label: "[i:1162] Mostrar Información de las Alas"
		Tooltip: Si está habilitado, las alas muestran su tiempo de vuelo y velocidad horizontal en su descripción.
	}

	ammunitionTooltips: {
		Label: "[i:4915] Mostrar Información de la Munición"
		Tooltip: Si está habilitado, las armas a distancia muestran qué munición disparan.
	}

	shimmerableTooltip: {
		Label: "[i:5348] Información de Transformación en Fulgor"
		Tooltip: Si está habilitado, los objetos muestran en qué se transforman al arrojarlos al Fulgor.
	}

	worldAndPlayerInfo: {
		Label: "[i:393] Mostrar Información en la Pantalla de Selección"
		Tooltip: Si está habilitado, los mundos y personajes muestran información útil en su pantalla de selección, como si un mundo está en modo difícil, qué mejoras se han usado, etc.
	}

	fixPvPUI: {
		Label: "[i:181] Corregir la Posición del Icono de Equipo"
		Tooltip:
			'''
			Cuando hay instalados mods con muchos NPC de la ciudad, los iconos de equipo y PvP se superponen a las viviendas de los NPC.
			Si está habilitado, los iconos se desplazan para que no se superpongan.
			'''
	}

	fixMemoryLeaks: {
		Label: "[i:1344] Corregir Magic Storage"
		Tooltip: Si está habilitado, soluciona que el juego no inicie o se quede colgado en "Cargando contenido" con Magic Storage habilitado.
	}

	fasterModLoading: {
		Label: "[i:3099] Carga de Mods Más Rápida"
		Tooltip:
			'''
			tModLoader tiene un bucle encantador que acelera la carga de texturas durante la pantalla de carga. Un error tipográfico hace que nunca se ejecute.
			Si está habilitado, parcheamos la pantalla de carga para que realmente se ejecute y acelere drásticamente la pantalla de carga para no esperar.
			'''
	}

	vanillaThoriumTooltips: {
		Label: "[i:3572] Descripciones de Thorium Estilo Vanilla"
		Tooltip:
			'''
			Muchas descripciones en el mod Thorium se ven extrañas en comparación con las de Terraria.
			Si está habilitado, esta opción hace que se parezcan más al estilo del juego base.
			'''
	}

	removeThoriumEnabledCraftingTooltips: {
		Label: "[i:666] Eliminar Condiciones de Receta Innecesarias"
		Tooltip:
			'''
			Los objetos de Thorium añaden una condición de "Habilitado en la configuración del mod Thorium" a los objetos de donador.
			En Magic Storage y Recipe Browser, el texto es demasiado largo y totalmente innecesario.
			Si está habilitado, esta opción elimina esos textos de la descripción de los objetos de fabricación.
			'''
	}

	invertRecipeListScrolling: {
		Label: "[i:36] Invertir Desplazamiento de la Lista de Recetas"
		Tooltip: Si está habilitado, la lista de recetas se desplaza en la dirección correcta.
	}

	metricSystem: {
		Label: "[i:393] Usar Sistema Métrico"
		Tooltip: ¿Estás usando el sistema métrico como el 96% de la población mundial? Si está habilitado, las unidades se muestran en unidades métricas.
	}

	twentyFourHourTime: {
		Label: "[i:709] Hora en Formato de 24 Horas"
		Tooltip: ¿Estás usando el sistema métrico como el 96% de la población mundial? Si está habilitado, los relojes muestran la hora en formato de 24 horas.
	}

	showLuck: {
		Label: "[i:4361] Mostrar Estadística de Suerte"
		Tooltip: Si está habilitado, el detector de metales (o sus mejoras) muestra la suerte que tienes.
	}

	disableShimmerPumping: {
		Label: "[i:581] Corregir Exploit de Bombeo de Fulgor"
		Tooltip: Si está habilitado, deshabilita mover el Fulgor con bombas antes de derrotar al Señor de la Luna para evitar que el Fulgor sea movido demasiado pronto.
	}

	autoJoinTeam: {
		Label: "[i:181] Unirse Automáticamente al Equipo Multijugador"
		Tooltip: Si está habilitado, el juego se une automáticamente al equipo seleccionado al entrar en un servidor multijugador.
	}

	teamToAutoJoin: {
		Label: "[i:182] Equipo al que Unirse Automáticamente"
		Tooltip: Selecciona a qué equipo unirse automáticamente.
	}

	mapSharing: {
		Label: "[i:893] Compartir Mapa"
		Tooltip:
			'''
			¡Ya no corrompe tu mapa! Si está habilitado, las áreas exploradas del mapa se sincronizan automáticamente con otros jugadores.
			Muy god.
			'''
	}

	mapSharingTeamOnly: {
		Label: "[i:893] Compartir Mapa Solo con el Equipo"
		Tooltip: Si está habilitado, el mapa compartido solo se comparte dentro de tu equipo. Bueno para JcJ y/o amigos fisgones.
	}

	overTimeNurseHealing: {
		Label: "[npc/n:18] Corrección de Curación de la Enfermera"
		Tooltip: Si está habilitado, la Enfermera cura a los jugadores con el tiempo para evitar explotar su función de curación.
	}

	nurseHealingTime: {
		Label: "[i:73] Tiempo de Curación de la Enfermera"
		Tooltip: Controla durante cuánto tiempo debe curar la Enfermera al jugador. Cuanto mayor sea el valor, más lenta será la curación.
	}

	disableTownSlimes: {
		Label: "[npc/n:670] Desactivar Slimes de la Ciudad"
		Tooltip: Esta opción desactiva los slimes de la ciudad. También asesina a esas pobrecitas criaturas al entrar al mundo, monstruo.
	}

	ancientSwords: {
		Label: "[i:757] Activar Espadas Antiguas"
		Tooltip:
			'''
			Si está habilitado, añade variantes antiguas de espadas que fueron rediseñadas en la 1.4.4 para basarse más en proyectiles.
			¡Devuelve la Espada de la Noche clásica y la Espada Terra!
			'''
	}

	enableLockOn: {
		Label: "[g:1] Activar Fijación de Blanco"
		Tooltip: Si está habilitado, carga el sistema necesario para habilitar la fijación de blanco con ratón y teclado. Requiere reiniciar.
	}

	lockOn: {
		Label: "[g:1] Fijación de Blanco"
		Tooltip: Si está habilitado, permite el uso de la fijación de blanco si usas ratón y teclado.
	}

	moreBuffSlots: {
		Label: "[i:292] Más Espacios para Beneficios"
		Tooltip: Aumenta el número de espacios para beneficios según el valor de esta entrada de configuración. Establécelo en 0 para desactivar.
	}

	queenBeeLarvaeBreak: {
		Label: "[i:1133] Larvas de Abeja Reina Menos Frágiles"
		Tooltip: Si está habilitado, las larvas de la Abeja Reina ya no pueden romperse con balanceos aleatorios de espada o proyectiles perdidos, solo con un pico.
	}

	disablePrefixChangingRarity: {
		Label: "[i:398] Desactivar Cambio de Rareza por Prefijo"
		Tooltip: Si está habilitado, los objetos reforjados no cambiarán de rareza. No se aplica a objetos existentes.
	}

	softDungeonBricks: {
		Label: "[i:139] Ladrillos de la Mazmorra Blanditos"
		Tooltip: Si está habilitado, los ladrillos de la mazmorra son demasiado blandos para tu pico, igual de blandengue que tú.
	}

	assetFix: {
		Label: "[i:38] Corregir DragonLens en Linux"
		Tooltip:
			'''
			Si está habilitado, Vanilla+ QoL cambia las mayúsculas y minúsculas de los archivos de Terraria. Esto soluciona varios mods que intentan cargar archivos pero distinguen entre mayúsculas y minúsculas.
			Esto ocurre porque los sistemas de archivos en Linux distinguen entre mayúsculas y minúsculas, por lo que "Projectile" y "projectile" son dos archivos diferentes.
			(Debes reiniciar tu juego después de habilitar esto para evitar que ocurra el error.)
			'''
	}

	accessorySlotUnlock: {
		Label: "[i:3335] Desbloquear Espacios de Accesorio de Modo Experto/Maestro"
		Tooltip:
			'''
			Si está habilitado, los 8 espacios de accesorio se pueden desbloquear en todas las dificultades.
			Sigues sin poder conseguir un Corazón de Demonio del Muro Carnoso en modo Clásico, tendrás que usar un mundo en modo Experto.
			'''
	}

	drillRework: {
		Label: "[i:2774] Rediseño de Taladros"
		Tooltip:
			'''
			Si está habilitado, los taladros se rediseñan para poder recibir prefijos de velocidad cuerpo a cuerpo y beneficiarse de la velocidad de minería.
			Además, también pueden romper hierba de un solo golpe.
			A cambio, su velocidad base se reduce y solo obtienen un 25% de aumento en la velocidad de minería en lugar de un 60%.
			'''
	}

	sliceOfCakeUntilDeath: {
		Label: "[i:3750] El Trozo de Pastel Dura Hasta la Muerte"
		Tooltip: Si está habilitado, el beneficio otorgado por el trozo de pastel dura hasta que el jugador muere, en lugar de dos minutos.
	}

	deathLessBuffs: {
		Label: "[i:487] Beneficios Persistentes Sobreviven a la Muerte"
		Tooltip: Si está habilitado, los beneficios persistentes (otorgados por estaciones como la Mesa de Hechizos o el Trozo de Pastel) no se eliminan cuando el jugador muere.
	}

	wallsDontExplode: {
		Label: "[i:1101] Paredes a Prueba de Explosiones"
		Tooltip: Si está habilitado, las paredes de Lihzahrd y de la Mazmorra (tanto seguras como peligrosas) son a prueba de explosiones, al igual que sus contrapartes en bloque.
	}

	hardModeOresCanExplode: {
		Label: "[i:1106] Minerales del Modo Difícil Pueden Explotar"
		Tooltip: Si está activado, los minerales del modo difícil se pueden destruir con explosivos después de derrotar a los jefes mecánicos.
	}

	meteoriteCanExplode: {
		Label: "[i:117] Meteoritos Pueden Explotar"
		Tooltip:
			'''
			Si está activado, los meteoritos se pueden destruir con explosivos antes del modo difícil, en lugar de solo en el modo difícil.

			'''
	}

	dynamicDCUPickaxe: {
		Label: "[i:2768] DCU Dinámica"
		Tooltip: Si está activado, la Unidad de contención de excavación toma en cuenta el poder de pico del pico situado arriba a la izquierda en tu inventario.
	}

	moreExplosives: {
		Label: "[i:VanillaQoL/BouncyDirtDynamite] Más Explosivos"
		Tooltip: Si está activado, añade más variantes de explosivos al juego.
	}

	respawningRework: {
		Label: "[i:889] Rediseño de Reaparición"
		Tooltip: Si está activado, habilita el sistema necesario para cargar los ajustes de esta sección.
	}

	naturesGiftGlow: {
		Label: "[i:223] Brillo de Don de La Naturaleza Y Rosa de La Selva"
		Tooltip: Si está activado, el Don de la naturaleza y la Rosa de la selva brillan en la selva de forma similar a las esporas de la selva para que sea más fácil encontrarlos.
	}

	respawnTime: {
		Label: "[i:3230] Tiempo de Reaparición"
		Tooltip: Controla el tiempo de reaparición base.
	}

	respawnFactorExpertMode: {
		Label: "[i:3223] Factor de Modo Experto"
		Tooltip: Controla el multiplicador del tiempo de reaparición en el modo Experto.
	}

	respawnFactorMasterMode: {
		Label: "[i:4924] Factor de Modo Maestro"
		Tooltip: Controla el multiplicador del tiempo de reaparición en el modo Maestro.
	}

	bossRespawnTime: {
		Label: "[i:43] Tiempo de Reaparición (Jefe)"
		Tooltip: Controla el tiempo de reaparición base cuando hay un jefe vivo.
	}

	eventRespawnTime: {
		Label: "[i:1844] Tiempo de Reaparición (Evento)"
		Tooltip: Controla el tiempo de reaparición base cuando no hay ningún jefe vivo pero hay un evento en curso.
	}

	bossMultiplayerMultiplier: {
		Label: "[i:1969] Multiplicador por Jugador"
		Tooltip: Multiplica el tiempo de reaparición por este valor, multiplicado por el número de otros jugadores en el servidor.
	}

	christmasAllYear: {
		Label: "[i:1872] Navidad Todos Los Días"
		Tooltip: Si está activado, el espíritu de la Navidad está presente durante todo el año.
	}

	halloweenAllYear: {
		Label: "[i:1813] Halloween Todos Los Días"
		Tooltip: Si está activado, los fantasmas de las almas difuntas están presentes durante todo el año.
	}

	shopExpander: {
		Label: "[i:73] Shop Expander"
		Tooltip: Si está activado, Vanilla+ QoL añade páginas a las tiendas para que quepan todos los objetos, entre las cuales puedes cambiar usando dos botones.
	}

	extraSellPages: {
		Label: "[i:72] Páginas de Venta Adicionales"
		Tooltip: Si está activado, cuando una tienda se llena al venderle objetos, se crea una nueva página para ampliar la tienda.
	}

	lifeCrystalGlow: {
		Label: "[i:29] Brillo de Cristales de Vida"
		Tooltip: Si está activado, los Cristales de vida emiten una luz tenue para que sea más fácil encontrarlos.
	}

	lifeFruitGlow: {
		Label: "[i:1291] Brillo de Frutas de Vida"
		Tooltip: Si está activado, las Frutas de vida brillan de forma similar a las esporas de la selva para que sea más fácil encontrarlas.
	}

	NPCsLiveInEvilBiomes: {
		Label: "[i:8] Los PNJ Pueden Vivir En Biomas Malignos"
		Tooltip:
			'''
			Si está activado, los NPC toleran a regañadientes la Corrupción y el Carmesí.
			Aun así te odiarán y serán muy infelices. No seas cruel.
			'''
	}

	disableBiomeSpread: {
		Label: "[i:199] Desactivar Propagación de Biomas"
		Tooltip:
			'''
			Si está activado, los biomas infecciosos como el Carmesí, la Corrupción y la Bendición no se extienden.
			'Tu día del juicio final aún no ha llegado'
			'''
	}

	noDroppedSand: {
		Label: "[i:169] Sin Caída de Arena"
		Tooltip: Si está activado, las hormigas león no ensucian tu mundo con arena, soltándola en forma de objeto en su lugar.
	}

	noDroppedSnow: {
		Label: "[i:593] Sin Caída de Nieve"
		Tooltip: Si está activado, los Muñecos de nieve... o sea, los Hombres de nieve no ensucian tu mundo con nieve, soltándola en forma de objeto en su lugar.
	}

	noDroppedTombstones: {
		Label: "[i:1175] Sin Lápidas Caídas"
		Tooltip:
			'''
			Si está activado, las lápidas se sueltan como objeto en lugar de colocarse y crear un cementerio.
			'Para los mancos'
			'''
	}

	noDroppedSandgun: {
		Label: "[i:266] Sin Caída de Arena (Pistola de arena)"
		Tooltip:
			'''
			Si está activado, la pistola de arena ya no coloca arena al usarlo.
			Si activas esto, debería darte vergüenza, ya que hará que el arma esté ridículamente rota.
			'''
	}

	mountFallDamage: {
		Label: "[i:2430] Sin Daño Por Caída Con Montura"
		Tooltip: Si está activado, no recibirás daño por caída al montar cualquier montura.
	}

	disableShimmering: {
		Label: "[t:VanillaQoL/UI/Shimmer] Sin Caer A Través del Éter"
		Tooltip: Si está activado, no caerás a través del mundo al caer en el éter. Puedes tomarte un baño en él :)
	}

	modNameTooltip: {
		Label: "[i:2208] Descripción de Nombre del Mod"
		Tooltip: Si está activado, los objetos muestran de qué mod provienen en su descripción.
	}

	testing: {
		Label: "[i:2] Pruebas"
		Tooltip: Si activas esto, ¡prepárate para lo peor :)
	}

	jungleMimic: {
		Label: "[npc/n:476] Los Mímicos de La Selva Aparecen En La Selva del Modo Difícil"
		Tooltip: Si está activado, tu experiencia en la selva subterránea será mejorada por los mímicos de la selva.
	}

	clownExplosions: {
		Label: "[npc/n:109] Las Bombas Felices de Los Payasos Destruyen Bloques"
		Tooltip: Si está activado, las bombas felices lanzadas por los payasos destruyen bloques en una pequeña explosión.
	}

	naturalFrostLegion: {
		Label: "[i:602] La Legión de Escarcha Aparece Naturalmente"
		Tooltip: Si está activado, la Legión de escarcha puede aparecer aleatoriamente por la noche cuando hay una tormenta de nieve.
	}

	enemiesBreakDoors: {
		Label: "[i:25] Los Enemigos Rompen Puertas"
		Tooltip: Si está activado, los enemigos no solo llaman cortésmente, sino que rompen la puerta como lo hacen los duendes.
	}

	nonConsumableSummons: {
		Label: "[i:43] Invocaciones de Jefes No Consumibles"
		Tooltip: Si está activado, las invocaciones de jefes no se consumen.
	}

	veinMining: {
		Label: "[i:385] VeinMining™"
		Tooltip: Si está activado, al romper un bloque de mineral, los minerales adyacentes también se minan.
	}

	veinMiningSpeed: {
		Label: "[i:3509] Velocidad de VeinMining™"
		Tooltip: Controla el retardo entre la rotura de bloques. Un valor más bajo significa una minería en vetas más rápida.
	}

	extendedOres: {
		Label: "[i:424] Tecnología ExtendedOres™"
		Tooltip: Si está activado, ¡nuestra tecnología patentada y con marca registrada añade nuevos, emocionantes e impactantes minerales a VeinMine™!
	}

	wingSlot: {
		Label: "[i:1162] Ranura de Alas™"
		Tooltip: Si está activado, se añade una ranura de accesorio para alas al jugador. Puedes poner alas, globos y las botellas en ella.
	}

	moveCredits: {
		Label: "[i:5044] Creditos"
		Tooltip: Controla cómo se muestran los créditos del final del juego.
	}

	axeReplanting: {
		Label: "[i:3506] Las Hachas Replantan Bellotas"
		Tooltip: Si está activado, talar un árbol con un hacha siempre replanta una bellota en su lugar.
	}

	ninja: {
		Label: "[i:256] Ninja"
		Tooltip: Si está activado, se añade un NPC de la ciudad, el Ninja. Puede ser rescatado del Rey Slime tras derrotarlo.
	}

	quickBuffFavourite: {
		Label: "[i:289] Solo Consumir Pociones Favoritas Con Mejora Rápida"
		Tooltip: Si hay pociones marcadas como favoritas en el inventario, Mejora rápida solo consumirá las que sean favoritas.
	}

	noFullHeartPickup: {
		Label: "[i:58] No Consumir Corazones Con PV al Máximo"
		Tooltip: Si está activado y el jugador tiene los PV al máximo, no recogerá corazones. Del mismo modo, si el jugador tiene maná al máximo, no recogerá cristales de maná.
	}

	heartTime: {
		Label: "[i:58] Tiempo de Desaparición de Corazones"
		Tooltip: Controla cuánto tiempo permanecen los corazones y los cristales de maná en el mundo antes de desaparecer, en segundos. El valor por defecto es 300, que son 5 minutos.
	}

	calamityInWorldRarity: {
		Label: "[t:VanillaQoL/UI/Wrench] Corrección de Rareza de Calamity"
		Tooltip: Si está activado, los colores de rareza de las armas de Calamity se muestran correctamente en el texto al recogerlas o cuando los objetos flotan en el mundo.
	}

	cactusHurts: {
		Label: "[i:276] El Cactus Hiere a los Jugadores"
		Tooltip: Si está activado, tocar un cactus inflige 10 de daño, tal como en el viejo y buen 1.1.
	}

	jungleThornsAreSticky: {
		Label: "[i:210] Las Espinas son Pegajosas"
		Tooltip: Si está activado, las espinas ralentizan al jugador como lo hacen las telarañas.
	}

	drShield: {
		Label: "[i:156] Reducción de Daño en Escudo"
		Tooltip: Si está activado, el escudo de defensa también muestra la estadística de reducción de daño.
	}

	stopSantaFromExploding: {
		Label: "[i:588] Evitar que Papá Noel Explote"
		Tooltip: Si está activado, Papá Noel no explotará repentinamente tras el final de las fiestas.
	}

	truffleKingAndQueenStatue: {
		Label: "[i:ShrimpyTruffle] Trufa es No Binaria"
		Tooltip: Si está activado, Trufa se teletransportará tanto a la estatua del rey como a la de la reina.
	}

	sellAdditionalItems: {
		Label: "[i:73] Los NPC de la Ciudad Venden Objetos Adicionales"
		Tooltip: Si está activado, los NPC de la ciudad venden pociones, varios materiales y otras cosas diseñadas para reducir el grindeo.
	}

	persistentBuffs: {
		Label: "[i:GravitationPotion] Las Pociones Persisten al Morir"
		Tooltip: Si está activado, todos los beneficios que persisten al guardar (las pociones en el juego base) persistirán cuando el jugador muera.
	}

	pannoniaeCat: {
		Label: "[npc/n:637] Gato Pannoniae"
		Tooltip: Si está activado, Pannoniae es un gato.
	}

	panicKey: {
		Label: "[i:1290] Tecla de Pánico"
		Tooltip: Si está activado, se añade una tecla rápida que te permite usar rápidamente un objeto de teletransporte. Se prefieren las pociones de regreso a los espejos mágicos.
	}

	veinMineSpikes: {
		Label: "[i:1150] Expansión de Púas para VeinMining™"
		Tooltip:
			'''
			Si está activado, la renombrada tecnología VeinMining™ también funciona a la perfección con esos molestos pinchos de tu mundo.
			¡Pruébalo hoy y si no te gusta, te devolvemos el dinero!
			'''
	}

	soyMasterMode: {
		Label: "[i:4938] Reducción de Estadísticas del Modo Maestro"
		Tooltip: Si está activado, los enemigos en el Modo Maestro tienen las estadísticas del Modo Experto. Es bueno si no te gusta que los conejos te empalen al aparecer.
	}

	morePylons: {
		Label: "[i:4916] Más Torres"
		Tooltip:
			'''
			Si está activado, Vanilla+ QoL añade una torre de la Corrupción y otra del Carmesí para que los NPC los usen.
			Se recomienda activar la opción de configuración de que los NPC vivan en biomas malvados.
			'''
	}

	honeyImmuneHoneyLamps: {
		Label: "[i:2129] Linternas de Miel Inmunes a la Miel"
		Tooltip: Si está activado, las linternas de miel no se rompen al colocarlas en la miel.
	}

	mineWallsFromInside: {
		Label: "[i:30] Romper Paredes Inseguras en Cualquier Parte"
		Tooltip: Si está activado, las paredes inseguras no necesitan estar expuestas al aire para poder romperse.
	}

	noLavaSlime: {
		Label: "[npc/n:59] Sin Lava de Slimes de Lava"
		Tooltip: Si está activado, los slimes de lava no sueltan lava al morir en Modo Experto.
	}

	instantPlatformFallthrough: {
		Label: "[i:94] Caída Instantánea a Través de Plataformas"
		Tooltip: Si está activado, puedes caer a través de las plataformas al instante manteniendo pulsada la tecla de abajo.
	}

	torchesOnPlatforms: {
		Label: "[i:8] Antorchas Inteligentes en Plataformas"
		Tooltip:
			'''
			La versión 1.4.4 añadió antorchas a las plataformas, pero olvidó la parte en la que el cursor inteligente también debería incluirlas. ¡Fuera bichos!
			Si está activado, las antorchas también aparecerán como sugerencia de colocación.
			'''
	}

	smartPlatformPlacement: {
		Label: "[i:94] Colocación Inteligente de Plataformas"
		Tooltip:
			'''
			Si está activado, hace que el cursor inteligente sea más inteligente añadiendo "margen" a la dirección de colocación
			para que tus plataformas no sigan saliéndose por los lados o se interrumpan aleatoriamente por un árbol o hierba alta.
			'''
	}

	wallsRespectPlatforms: {
		Label: "[i:93] Las Paredes Respetan las Plataformas"
		Tooltip:
			'''
			Si está activado, la colocación de paredes trata los suelos de plataformas como suelos en lugar de aire,
			evitando que la colocación del cursor inteligente se filtre a través de la "sala" que hiciste para tu arena de jefes.
			'''
	}

	blocksReplaceGrass: {
		Label: "[i:2] Cursor Inteligente sin Hierba"
		Tooltip:
			'''
			Si está activado, la hierba y las enredaderas ya no bloquean la colocación del cursor inteligente. Atrás quedaron los días de construir para el Ejército del Antiguo
			dejando un hueco en el suelo...
			'''
	}

	smartCursorRange: {
		Label: "[i:407] Corrección de Alcance del Cursor Inteligente"
		Tooltip:
			'''
			Los accesorios de rango modificados amplían la distancia a la que puedes colocar bloques, pero el cursor inteligente
			nunca se enteró. Si está activado, ¡esto ya no pasa!
			'''
	}

	coincumberingStone: {
		Label: "[i:4346] Piedra Agobiante (Monedas)"
		Tooltip: Si está activado, el jugador que lleve la Piedra Agobiante podrá seguir recogiendo monedas.
	}

	coincumberingStoneRename: {
		Label: "[i:4346] Cambio de Nombre de la Piedra Agobiante (Monedas)"
		Tooltip: Si está activado, la Piedra agobiante pasa a llamarse Piedra Agobiante (Monedas).
	}

	killableDungeonNPCs: {
		Label: "[npc/n:72] NPC de la Mazmorra Destruíbles"
		Tooltip: Si está activado, las Ruedas Llameantes y las Bolas de Pinchos se pueden matar. Es útil si te molestan los malditos idiotas llameantes invencibles.
	}

	exactTooltips: {
		Label: "[i:3123] Descripciones de Armas Exactas"
		Tooltip: Si te gusta destruir tu inmersión, puedes habilitar que se muestren valores exactos para el retroceso y el tiempo de uso en las descripciones.
	}

	damageSpread: {
		Label: "[i:1301] Dispersión de Daño"
		Tooltip: Alterna la dispersión de daño entre normal (por defecto), solo para enemigos y desactivada. Cuando la dispersión de daño está desactivada, Terraria no aleatoriza el daño infligido.
	}

	damageSpreadAmount: {
		Label: "[i:1301] Cantidad de Dispersión de Daño (%)"
		Tooltip: Establece la cantidad de dispersión de daño si está activada. El valor predeterminado es 15%, y se puede configurar entre 0% y 100%, lo que da como resultado un rango de daño de 0-2x.
	}

	superCrits: {
		Label: "[i:1858] Super Críticos"
		Tooltip:
			'''
			Si está activado, las probabilidades de crítico superiores al 100% dan lugar a super críticos que infligen 3 veces el daño, las probabilidades de crítico superiores al 200% dan lugar a 4 veces el daño y así sucesivamente.
			Tus esfuerzos ya no son en vano.
			'''
	}

	superCritsColourValue: {
		Label: "[i:1858] Color de los Super Críticos"
		Tooltip: Establece el color de los super críticos.
	}

	superCritsColour: {
		Label: "[i:1858] Super Críticos de Colores"
		Tooltip: Si está activado, los super críticos tienen un color único que los distingue de los críticos normales.
	}

	superCritsColouredDamageTypesIntegration: {
		Label: "[i:1858] Integración de Tipos de Daño con Colores para Super Críticos"
		Tooltip: Si está activado, se habilita la integración con el mod Coloured Damage Types, lo que permite que los super críticos se coloreen según el tipo de daño del arma.
	}

	superCritsColouredDamageTypesDarken: {
		Label: "[i:1858] Oscurecimiento de Tipos de Daño para Super Críticos"
		Tooltip:
			'''
			Controla cuánto se oscurecen los super críticos en comparación con el color de los críticos normales.
			El color más brillante se oscurece a la mitad de este valor, y todos los demás por el valor completo.
			'''
	}

	removeOneDrop: {
		Label: "[i:3389] Eliminar Descripción de One Drop"
		Tooltip: Si está activado, elimina el logotipo de One Drop de los yoyós que están basados en yoyós reales fabricados por One Drop.
	}

	removeDevSet: {
		Label: "[i:666] Eliminar Objetos de Set de Desarrollador"
		Tooltip: Si está activado, las bolsas del tesoro ya no sueltan objetos de desarrollador. Se acabó la diversión, se acabaron los estorbos en el inventario.
	}

	quickBestiary: {
		Label: "[npc/n:633] Desbloqueo Rápido del Bestiario"
		Tooltip: Si está activado, las entradas del bestiario se desbloquean tras una sola baja en lugar de la cantidad normal (un estandarte).
	}

	critsBypassDefense: {
		Label: "[i:4005] Los Críticos Ignoran la Defensa"
		Tooltip: Si está activado, los golpes críticos ignoran la defensa de los enemigos. Esto hace que las configuraciones centradas en críticos sean más viables sin tener que acumular perforación de armadura.
	}

	asphaltPlatform: {
		Label: "[i:VanillaQoL/AsphaltPlatform] Plataforma de Asfalto"
		Tooltip: Si está activado, añade una plataforma hecha de asfalto. Comúnmente incluida en tus mods de trampas favoritos, pero esta vez, también está en el mío.
	}

	autoResearchFavourite: {
		Label: "[i:75] Investigar Automáticamente Objetos Favoritos"
		Tooltip: Si está activado, los objetos en el inventario del jugador se investigan automáticamente si están marcados como favoritos. [c/FF5555:Devorará tus objetos.]
	}

	itemsWorkInBanks: {
		Label: "[i:87] Los Objetos Funcionan en el Almacenamiento Personal"
		Tooltip: Si está activado, los objetos funcionan en el almacenamiento personal del jugador como accesorios de información. Todos sabemos que tu inventario está lleno de pociones.
	}

	itemsWorkInBanksTooltip: {
		Label: "[i:3213] Descripción de Objetos que Funcionan en el Almacenamiento Personal"
		Tooltip: Si está activado, se añade una descripción a los objetos en el almacenamiento personal que funcionan como accesorios del jugador.
	}

	fountainBiomes: {
		Label: "[i:909] Las Fuentes Cambian de Bioma"
		Tooltip: Si está activado, las fuentes colocadas cambian el bioma del área que las rodea al bioma del que están hechas. Solo es un poco trampa, ¿no?
	}

	fountainFromInventory: {
		Label: "[i:4417] Las Fuentes Cambian de Bioma desde el Inventario"
		Tooltip: Si está activado, las fuentes también cambian el bioma del área que te rodea cuando las llevas en el inventario. A estas alturas, por favor, siente un poco de vergüenza por hacer tanta trampa.
	}

	removeBiomeRequirementsShops: {
		Label: "[i:4766] Eliminar Requisitos de Bioma para las Tiendas"
		Tooltip:
			'''
			Si está activado, los NPC venden objetos sin importar el bioma en el que se encuentren. Esto normalmente saturaría la tienda, ¿pero no es por esto que tenemos el Shop Expander?
			Requiere que Shop Expander esté activado. No me preguntes por qué, está maldito.
			'''
	}

	stackableQuestItems: {
		Label: "[i:2452] Objetos de Misión Apilables"
		Tooltip: Si está activado, los objetos de misión como los peces de misión se pueden apilar en el inventario.
	}

	axeReplantingHerbs: {
		Tooltip: ""
		Label: Replantación de Hierbas con Hacha
	}

	OOAdrops: {
		Label: "[i:3817] Los Mini Jefes del Ejército del Antiguo Sueltan Medallas del Defensor"
		Tooltip: Si está activado, los mini jefes del evento del Ejército del Antiguo también sueltan Medallas del Defensor por si no puedes superar el evento completo.
	}

	OOAdrops2: {
		Label: "[i:3817] Caída Gradual de Medallas del Defensor del Ejército del Antiguo"
		Tooltip: Si está activado, los primeros dos niveles del evento del Ejército del Antiguo también sueltan Medallas del Defensor por si ni siquiera puedes sobrevivir a las primeras dos oleadas.
	}

	masterModeRelicsInExpert: {
		Label: "[i:4934] Las Reliquias del Modo Maestro Pueden Caer en Experto"
		Tooltip: Si está activado, las reliquias del Modo Maestro pueden soltarse en mundos del Modo Experto. El valor solo se roba de manera incremental.
	}

	allHairsOnStart: {
		Label: "[i:1989] Todos los Estilos de Pelo Disponibles desde el Inicio"
		Tooltip: Si está activado, todos los estilos de pelo están disponibles desde el principio del juego. No hay necesidad de encontrar a la Estilista para desbloquearlos.
	}

	stackVoidBag: {
		Label: "[i:4131] Bolsa del Vacío Inteligente"
		Tooltip: Si está activado, los objetos recogidos se apilan automáticamente en la Bolsa del Vacío si esta ya contiene el objeto.
	}

	storageFollowsPlayer: {
		Label: "[i:3213] Los Almacenamientos Móviles Siguen al Jugador"
		Tooltip: Si está activado, los almacenamientos móviles (Abrevadero de dinero, Bolsa del Vacío) siguen al jugador cuando se mueve. 'Toma esto...'
	}

	npcDeathsToCallOffInvasion: {
		Label: "[i:361] Muertes de NPC para Cancelar Invasiones"
		Tooltip: Si se establece en un valor superior a 0, las invasiones terminarán antes cuando este número de NPC de la ciudad mueran durante la invasión. Establécelo en 0 para desactivarlo.
	}

	playerDeathsToCallOffInvasion: {
		Label: "[i:1175] Muertes de Jugadores para Cancelar Invasiones"
		Tooltip: Si se establece en un valor superior a 0, las invasiones terminarán antes cuando el jugador muera este número de veces durante la invasión. Establécelo en 0 para desactivarlo.
	}

	moreVoidVault: {
		Label: "[i:4076] Cámara del Vacío Ampliada"
		Tooltip:
			'''
			Si está activado, los otros objetos de almacenamiento personal (Hucha, Caja fuerte, Forja del defensor) también se pueden usar para almacenar objetos usando la Bolsa del Vacío.
			Sin embargo, sacarlos es un poco más complicado.
			'''
	}

	grammarFix: {
		Label: "[i:389] Corrección Gramatical"
		Tooltip:
			'''
			Si está activado, los prefijos de los objetos se mostrarán en posiciones gramaticalmente correctas para los objetos que empiezan por "The" (por ejemplo, "The Unreal Undertaker" en lugar de "Unreal The Undertaker").
			Solo afecta al inglés, ¿por qué iba a afectar a cualquier otra cosa?
			'''
	}

	siltIsDangerous: {
		Label: "[i:2329] Sentido del Peligro Destaca el Limo y la Aguanieve"
		Tooltip: Si está activado, la poción de sentido del peligro resalta los bloques de limo y aguanieve. Aunque igual te caerán en la cabeza.
	}

	thinIceNotDangerous: {
		Label: "[i:2329] Sentido del Peligro No Destaca el Hielo Fino"
		Tooltip: Si está activado, la poción de sentido del peligro deja de resaltar el hielo fino. De todas formas vas a caerte al agua, ¿sabes?
	}

	spelunkerHellstone: {
		Label: "[i:174] Espeleólogo Destaca la Piedra Infernal"
		Tooltip:
			'''
			Si está activado, la poción de espeleólogo resalta la Piedra Infernal.
			No es como si no pudieras verla entre tanta lava, pero aquí nos esforzamos por crear un entorno inclusivo.
			'''
	}

	moreBossLoot: {
		Label: "[i:3328] Más Armas en las Bolsas del Tesoro"
		Tooltip:
			'''
			Si está activado, la Abeja Reina, Plantera y Golem sueltan dos armas cada uno de sus Bolsas del Tesoro, de manera similar al Señor de la Luna.
			¡Menos grindeo, más diversión!
			   
			'''
	}

	disableNPCHappiness: {
		Label: "[i:4986] Desactivar la Felicidad de los NPC"
		Tooltip: Si está activado, se desactiva el sistema de felicidad de los NPC. El factor del precio de venta siempre será fijo.
	}

	disableNPCHappinessConstant: {
		Label: "[i:4986] Desactivar el Factor de Felicidad de los NPC"
		Tooltip: Esto controla el factor del precio de venta cuando el sistema de felicidad de los NPC está desactivado. Establécelo en 1.0 para dejarlo sin cambios respecto al precio completo, en 0.5 para reducir a la mitad los precios de venta, etc.
	}

	boundNPCProtection: {
		Label: "[npc/n:105] Protección de NPC Atados"
		Tooltip: Si está activado, los NPC atados están protegidos para que los enemigos no los maten.
	}

	fixStarlightRiver: {
		Label: "[i:75] Corregir la Aparición de Meteoritos de Starlight River"
		Tooltip:
			'''
			Si está activado, corrige el objeto Oración por el meteorito del mod Starlight River. Por defecto, no hace absolutamente nada porque los desarrolladores de Starlight River son monos de ChatGPT.
			Esto parchea WorldGen.dropMeteor para comprobar las condiciones correctamente.
			'''
	}

	fixInfernumCrystals: {
		Label: "[i:1332] Corregir los Carámbanos de Infernum que Cubren la Pantalla"
		Tooltip:
			'''
			Si está activado, corrige un error en Infernum que hace que los carámbanos del Ciervíclope cubran toda la pantalla.
			Esto nunca fue un error de Vanilla+ QoL, pero mucha gente pensó que lo era, así que más vale hacerlo nuestro ;)
			'''
	}
}

