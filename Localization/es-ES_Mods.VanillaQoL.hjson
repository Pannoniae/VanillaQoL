	Restored: {
		onFire: Otorga inmunidad a la desventaja ¡En llamas!
		notConsumable: No consumible
		manaBoost: +20 de maná máximo
		gladiatorDefence: +3 de defensa
		palladiumChest: 2% de aumento de daño
		palladiumLegs: 3% de aumento de daño
		orichalcumChest: 4% de aumento de probabilidad de impacto crítico
		crimsonPiece: 3% de aumento de daño y +0,5 PV/s de regeneración de vida
		crimsonChest: 3% de aumento de daño y +1 PV/s de regeneración de vida
		elysianLava: Otorga inmunidad a la lava y 10% de aumento de velocidad de movimiento
		critDamage: 15% de aumento de daño de impacto crítico
		trueMelee: 10% de aumento de daño cuerpo a cuerpo verdadero
		alcohol: Cuenta como alcohol
		noDefenceDamage: El daño a la defensa está desactivado
		spectreHealing:
			'''
			Convierte el daño mágico en fuerza curativa
			El daño mágico infligido a los enemigos cura al jugador con menos salud
			'''
		prefixDefence: +{0} de defensa
		prefixDR: +{0}% de reducción de daño
		prefixLuck: +0.05 de suerte

		Wings: {
			AngelWings: +20 de vida máxima, +10 de defensa y +0,5 PV/s de regeneración de vida
			DemonWings: 5% de aumento de daño y de probabilidad de impacto crítico
			ButterflyWings:
				'''
				+20 de maná máximo, 5% de reducción de uso de maná,
				5% de aumento de daño mágico y de probabilidad de impacto crítico mágico
				'''
			FairyWings: +60 de vida máxima
			BeeWings: Otorga permanentemente la mejora Miel
			HarpyWings: 20% de aumento de velocidad de movimiento
			FlameWings: 5% de aumento de daño cuerpo a cuerpo y de probabilidad de impacto crítico cuerpo a cuerpo
			FrozenWings:
				'''
				2% de aumento de daño cuerpo a cuerpo y a distancia
				y 1% de aumento de probabilidad de impacto crítico cuerpo a cuerpo y a distancia
				al llevar puesta la armadura helada
				'''
			GhostWings:
				'''
				+10 de defensa y 5% de aumento de reducción de daño al llevar el conjunto de capucha espectral
				5% de aumento de daño mágico y de probabilidad de impacto crítico al llevar el conjunto de máscara espectral
				'''
			BeetleWings:
				'''
				+10 de defensa y 5% de aumento de reducción de daño al llevar el conjunto de caparazón de escarabajo
				5% de aumento de daño cuerpo a cuerpo y de probabilidad de impacto crítico al llevar el conjunto de coraza de escamas de escarabajo
				'''
			FinWings:
				'''
				Efecto de branquias y puedes moverte libremente a través de los líquidos
				Caes más rápido mientras estás sumergido en líquido
				'''
			SteampunkWings:
				'''
				+8 de defensa, 10% de aumento de velocidad de movimiento,
				4% de aumento de daño y 2% de aumento de probabilidad de impacto crítico
				'''
			LeafWings:
				'''
				+5 de defensa, 5% de aumento de reducción de daño
				y Bendición de la Dríada permanente al llevar la armadura tiki
				'''
			BatWings:
				'''
				Por la noche o durante un eclipse, obtendrás las siguientes mejoras:
				7% de aumento de daño y 3% de aumento de probabilidad de impacto crítico
				'''
			TatteredFairyWings: 5% de aumento de daño y de probabilidad de impacto crítico
			SpookyWings: Aumento del retroceso de los súbditos y 5% de aumento de daño de los súbditos al llevar la armadura tétrica
			Hoverboard:
				'''
				5% de aumento de daño del tipo de arma correspondiente al llevar la armadura de piñonita
				El tipo de arma potenciado coincide con el casco de piñonita que se lleve puesto
				'''
			FestiveWings:
				'''
				+40 de vida máxima
				Caen adornos mientras vuelas
				'''
			MothronWings: +5 de defensa y 5% de aumento de daño
			WingsSolar:
				'''
				7% de aumento de daño cuerpo a cuerpo y 3% de aumento de probabilidad de impacto crítico cuerpo a cuerpo
				al llevar puesta la armadura de bengala solar
				'''
			WingsStardust: 10% de aumento de daño de los súbditos al llevar la armadura de polvo estelar
			WingsVortex:
				'''
				aumento de daño a distancia y 7% de aumento de probabilidad de impacto crítico a distancia
				al llevar puesta la armadura de vórtice
				'''
			WingsNebula:
				'''
				+20 de maná máximo, 5% de aumento de daño mágico y de probabilidad de impacto crítico,
				y 5% de reducción de uso de maná al llevar puesta la armadura de nebulosa
				'''
		}
	}

