ConfigDisabled: {
	needsThorium: 需要瑟银，未安装。
	needsCalamity: 需要灾厄，未安装。
	needsStarlightRiver: 需要星光之河，未安装。
	needsColouredDamageTypes: 需要Coloured Damage Types（彩色伤害类型）模组。缺少此模组将无法显示伤害颜色、类型及相关功能。
	needsInfernum: 需要灾厄炼狱，未安装。
	onlyWithoutCalamity: 此功能用于在无灾厄模组时还原其核心机制。您已安装灾厄模组，请勿启用。
	noCalamityOverlap: 此功能与灾厄模组存在冲突，已禁用以避免重复或功能异常。
}

SpawnConditions: {
	Guide: 游戏开始时即存在。若消失，责任在您。
	Merchant: 任意玩家持有 50银币。
	Nurse: 生命上限 超过100，且商人已入住。
	Demolitionist: 背包中持有 炸药。
	DyeTrader: 持有 染料 或 奇异植物。
	Angler: 在海边睡觉，叫醒他。
	BestiaryGirl: 完成 10% 生物图鉴。
	Dryad: 击败任意Boss。她对条件的要求不高。
	Painter: 世界中已有8名城镇NPC。
	Golfer: 在地下沙漠解救。
	ArmsDealer: 持有子弹或枪械。
	DD2Bartender: 击败世界吞噬怪或克苏鲁之脑后自动出现。
	Stylist: 在蜘蛛洞穴解救。
	GoblinTinkerer: 击败哥布林军队后于地下解救。
	WitchDoctor: 击败蜂王。
	Clothier: 击败骷髅王。
	Mechanic: 在地牢解救。
	PartyGirl: 拥有 14名城镇NPC，每日清晨以 2.5% 概率生成。
	Wizard: 困难模式下于 洞穴层 解救。
	TaxCollector: 在地狱对痛苦亡魂使用净化粉。
	Truffle: 困难模式下于地表发光蘑菇群系存在房屋。
	Pirate: 击败海盗入侵。
	Steampunker: 击败任意机械Boss。
	Cyborg: 击败世纪之花。
	SantaClaus: 圣诞节期间击败雪人军团。
	Princess: 所有其他常规城镇NPC均已入住。
	TownCat: 向动物学家购买猫咪许可证。
	TownDog: 购买 猫许可证 后，向动物学家购买狗狗许可证。
	TownBunny: 购买 狗许可证 后，向动物学家购买兔兔许可证。
	TownSlimeBlue: 击败史莱姆王。
	TownSlimeOld: 用金钥匙在地牢解救。
	TownSlimeGreen: 在天然的派对激活期间入住。
	TownSlimePurple: 会在打破太空层中的笨拙气球史莱姆的气球后入住。
	TownSlimeRainbow: 会在将闪耀史莱姆气球扔进微光后入住。
	TownSlimeRed: 可以在血月时钓到。
	TownSlimeYellow: 会在于丛林中将净化粉用在神秘青蛙上后搬进来。
	TownSlimeCopper: 会在将铜头盔或铜短剑扔给史莱姆后入住。
	Unknown: 生成条件未知。
}

Census: {
	next: 下一位NPC即将入住。
	ready: 已满足条件，仅需空置房屋。
	prices: 价格：{0}%
	lovesEveryone: 所有人，包括您。
}

